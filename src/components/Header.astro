---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const raw = Astro.url.pathname;
const path = raw.startsWith(base) ? '/' + raw.slice(base.length) : raw;
const current = path.replace(/\/+$/, '') || '/';
const on = (k) => (k === '/' ? current === '/' : current === k || current.startsWith(k + '/'));
const links = [
  { href: base,                 label: 'Início',     key: '/' },
  { href: `${base}aneis`,       label: 'Anéis',      key: '/aneis' },
  { href: `${base}brincos`,     label: 'Brincos',    key: '/brincos' },
  { href: `${base}colares`,     label: 'Colares',    key: '/colares' },
  { href: `${base}colecoes`,    label: 'Coleções',   key: '/colecoes' },
  { href: `${base}quem-somos`,  label: 'Quem Somos', key: '/quem-somos' },
  { href: `${base}ajuda`,       label: 'Ajuda',      key: '/ajuda' },
];
---
<header class="vc-hdr bg-white border-b border-line sticky top-0 z-50">
  <div class="vc-hdr-in container mx-auto px-4 md:px-6">

    <button type="button" id="vc-burger" class="vc-burger md:hidden" aria-label="Abrir menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <div class="vc-logo text-center">
      <a href={base} aria-label="Vivi Corrêa — início">
        <img src={`${base}logo.png`} alt="Vivi Correa Joias" class="vc-logo-img mx-auto" />
      </a>
    </div>

    <div class="vc-acoes">
      <a href={`${base}busca`} class="vc-icone" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </a>
      <a href={`${base}carrinho`} class="vc-icone vc-rel" aria-label="Sacola">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <span id="contador-carrinho" class="vc-badge hidden">0</span>
      </a>
    </div>

    <nav class="vc-nav-desktop hidden md:flex">
      {links.map(l => (
        <a href={l.href} class={`vc-link ${on(l.key) ? 'vc-on' : ''}`}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<div id="vc-scrim" class="vc-scrim md:hidden" hidden></div>
<aside id="vc-drawer" class="vc-drawer md:hidden" aria-hidden="true">
  <div class="vc-drawer-top">
    <img src={`${base}logo.png`} alt="Vivi Corrêa" class="vc-drawer-logo" />
    <button type="button" id="vc-close" class="vc-close" aria-label="Fechar menu">×</button>
  </div>
  <nav class="vc-drawer-nav">
    {links.map(l => (
      <a href={l.href} class={`vc-drawer-link ${on(l.key) ? 'vc-on' : ''}`}>
        <span>{l.label}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    ))}
  </nav>
  <div class="vc-drawer-pe">
    <p class="vc-drawer-marca">Vivi Corrêa</p>
    <p class="vc-drawer-sub">Joias autorais, feitas à mão</p>
  </div>
</aside>

<nav class="mobile-bottom-nav vc-bottom md:hidden" aria-label="Navegação rápida">
  <a href={base} class={`vc-tab ${on('/') ? 'vc-on' : ''}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3m10-11v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
    <span>Início</span>
  </a>
  <a href={`${base}colecoes`} class={`vc-tab ${on('/colecoes') ? 'vc-on' : ''}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A2 2 0 013 10V5a2 2 0 012-2h2z"/></svg>
    <span>Coleções</span>
  </a>
  <a href={`${base}busca`} class={`vc-tab ${on('/busca') ? 'vc-on' : ''}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <span>Busca</span>
  </a>
  <a href={`${base}carrinho`} class={`vc-tab ${on('/carrinho') ? 'vc-on' : ''}`}>
    <span class="vc-rel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <span id="contador-carrinho-mobile" class="vc-badge vc-badge-sm hidden">0</span>
    </span>
    <span>Sacola</span>
  </a>
</nav>

<style is:global>
  .vc-hdr{border-color:#e7dfd1;background:#fff}
  .vc-hdr-in{position:relative;display:grid;grid-template-columns:44px 1fr 44px;align-items:center;gap:8px;padding-top:10px;padding-bottom:10px}
  .vc-logo{grid-column:2}
  .vc-logo-img{height:44px;width:auto;display:block}
  .vc-acoes{grid-column:3;display:flex;align-items:center;justify-content:flex-end;gap:14px}
  .vc-icone{color:#3f372d;display:inline-flex;transition:color .25s}
  .vc-icone:hover{color:#8B7355}
  .vc-icone svg{width:23px;height:23px;display:block}
  .vc-rel{position:relative;display:inline-flex}
  .vc-badge{position:absolute;top:-7px;right:-8px;min-width:17px;height:17px;padding:0 4px;border-radius:99px;background:linear-gradient(135deg,#6f5940,#8B7355 60%,#c9b189);color:#fff;font-size:9.5px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(139,115,85,.45)}
  .vc-badge-sm{top:-6px;right:-7px;min-width:15px;height:15px;font-size:8.5px}
  .vc-burger{grid-column:1;width:40px;height:40px;display:flex;flex-direction:column;justify-content:center;gap:5px;background:none;border:none;padding:0 8px;cursor:pointer}
  .vc-burger span{display:block;height:1.6px;background:#3f372d;border-radius:2px;transition:transform .3s,opacity .25s,width .3s}
  .vc-burger span:nth-child(1){width:22px}
  .vc-burger span:nth-child(2){width:16px}
  .vc-burger span:nth-child(3){width:22px}
  .vc-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(6.6px) rotate(45deg)}
  .vc-burger[aria-expanded="true"] span:nth-child(2){opacity:0}
  .vc-burger[aria-expanded="true"] span:nth-child(3){width:22px;transform:translateY(-6.6px) rotate(-45deg)}
  .vc-nav-desktop{grid-column:1 / -1;justify-content:center;flex-wrap:wrap;gap:30px;margin-top:14px;padding-bottom:4px;font-size:12px;letter-spacing:.16em;text-transform:uppercase}
  .vc-link{color:#8a7f70;text-decoration:none;position:relative;padding-bottom:3px;transition:color .25s}
  .vc-link::after{content:"";position:absolute;left:0;right:0;bottom:0;height:1.5px;background:linear-gradient(90deg,#8B7355,#c9b189);transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .vc-link:hover{color:#8B7355}
  .vc-link:hover::after,.vc-link.vc-on::after{transform:scaleX(1)}
  .vc-link.vc-on{color:#8B7355;font-weight:600}
  @media(min-width:768px){
    .vc-hdr-in{grid-template-columns:1fr;padding-top:22px;padding-bottom:14px}
    .vc-logo{grid-column:1}
    .vc-logo-img{height:76px}
    .vc-acoes{position:absolute;right:24px;top:26px;grid-column:auto}
    .vc-icone svg{width:25px;height:25px}
    .vc-nav-desktop{grid-column:1}
  }
  .vc-scrim{position:fixed;inset:0;z-index:60;background:rgba(36,29,22,.5);backdrop-filter:blur(2px);opacity:0;transition:opacity .3s}
  .vc-scrim.on{opacity:1}
  .vc-drawer{position:fixed;top:0;left:0;bottom:0;z-index:61;width:min(84vw,320px);background:#faf9f7;display:flex;flex-direction:column;
    transform:translateX(-102%);transition:transform .38s cubic-bezier(.22,1,.36,1);box-shadow:14px 0 44px rgba(36,29,22,.22);visibility:hidden}
  .vc-drawer.on{transform:none;visibility:visible}
  .vc-drawer-top{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 14px;border-bottom:1px solid #e7dfd1;background:#fff}
  .vc-drawer-logo{height:38px;width:auto}
  .vc-close{width:34px;height:34px;border:1px solid #e7dfd1;border-radius:50%;background:#faf9f7;color:#6b5f4f;font-size:20px;line-height:1;cursor:pointer;transition:all .25s}
  .vc-close:hover{background:#8B7355;color:#fff;border-color:#8B7355}
  .vc-drawer-nav{flex:1;overflow-y:auto;padding:8px 0;scrollbar-width:thin;scrollbar-color:#c9b189 #f4f0e8}
  .vc-drawer-nav::-webkit-scrollbar{width:8px}
  .vc-drawer-nav::-webkit-scrollbar-track{background:#f4f0e8}
  .vc-drawer-nav::-webkit-scrollbar-thumb{background:#c9b189;border-radius:99px;border:2px solid #f4f0e8}
  .vc-drawer-link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:15px 18px;text-decoration:none;color:#3f372d;
    font-size:13px;letter-spacing:.13em;text-transform:uppercase;border-bottom:1px solid #f1ece2;transition:background .25s,color .25s,padding-left .25s}
  .vc-drawer-link svg{width:15px;height:15px;color:#c9b189;flex-shrink:0}
  .vc-drawer-link:hover{background:#f3ebdd;color:#8B7355;padding-left:22px}
  .vc-drawer-link.vc-on{color:#8B7355;font-weight:600;background:#f3ebdd;box-shadow:inset 3px 0 0 #8B7355}
  .vc-drawer-pe{padding:16px 18px calc(16px + env(safe-area-inset-bottom));border-top:1px solid #e7dfd1;background:#fff}
  .vc-drawer-marca{margin:0;font-family:'Cormorant Garamond',serif;font-size:20px;color:#241d16}
  .vc-drawer-sub{margin:2px 0 0;font-size:11px;color:#9a8d7a;letter-spacing:.06em}
  .vc-bottom{position:fixed;left:0;right:0;bottom:0;z-index:50;display:grid;grid-template-columns:repeat(4,1fr);
    background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid #e7dfd1;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -4px 20px rgba(36,29,22,.07)}
  .vc-tab{display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 2px 8px;text-decoration:none;color:#9a8d7a;transition:color .25s}
  .vc-tab svg{width:21px;height:21px;display:block}
  .vc-tab span:last-child{font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:500}
  .vc-tab.vc-on{color:#8B7355}
  .vc-tab.vc-on svg{stroke-width:1.9}
  .vc-tab:active{transform:scale(.94)}
  @media(min-width:768px){.vc-bottom,.vc-drawer,.vc-scrim{display:none!important}}
</style>

<script>
  function vcMedir(){
    const h = document.querySelector('.vc-hdr');
    const n = document.querySelector('.vc-bottom');
    const vis = el => el && getComputedStyle(el).display !== 'none';
    document.documentElement.style.setProperty('--hdr-h', (vis(h) ? h.offsetHeight : 0) + 'px');
    document.documentElement.style.setProperty('--nav-h', (vis(n) ? n.offsetHeight : 0) + 'px');
  }
  function vcContador(){
    let c = [];
    try { c = JSON.parse(localStorage.getItem('carrinho_vivi')) || []; } catch(e){ c = []; }
    const t = Array.isArray(c) ? c.reduce((a,i)=>a + (parseInt(i.quantidade)||0), 0) : 0;
    ['contador-carrinho','contador-carrinho-mobile'].forEach(id => {
      const el = document.getElementById(id);
      if (el){ el.textContent = String(t); el.classList.toggle('hidden', t === 0); }
    });
  }
  function vcDrawer(abrir){
    const d = document.getElementById('vc-drawer');
    const s = document.getElementById('vc-scrim');
    const b = document.getElementById('vc-burger');
    if (!d || !s || !b) return;
    b.setAttribute('aria-expanded', String(abrir));
    d.setAttribute('aria-hidden', String(!abrir));
    d.classList.toggle('on', abrir);
    if (abrir){ s.hidden = false; requestAnimationFrame(()=>s.classList.add('on')); document.body.style.overflow = 'hidden'; }
    else { s.classList.remove('on'); document.body.style.overflow = ''; setTimeout(()=>{ s.hidden = true; }, 300); }
  }
  function vcInit(){
    vcMedir(); vcContador();
    const b = document.getElementById('vc-burger');
    const c = document.getElementById('vc-close');
    const s = document.getElementById('vc-scrim');
    if (b) b.addEventListener('click', () => vcDrawer(b.getAttribute('aria-expanded') !== 'true'));
    if (c) c.addEventListener('click', () => vcDrawer(false));
    if (s) s.addEventListener('click', () => vcDrawer(false));
    document.querySelectorAll('.vc-drawer-link').forEach(a => a.addEventListener('click', () => vcDrawer(false)));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') vcDrawer(false); });
    if (window.ResizeObserver){
      const ro = new ResizeObserver(vcMedir);
      const h = document.querySelector('.vc-hdr'); const n = document.querySelector('.vc-bottom');
      if (h) ro.observe(h); if (n) ro.observe(n);
    }
  }
  vcInit();
  document.addEventListener('DOMContentLoaded', vcInit);
  window.addEventListener('load', vcMedir);
  window.addEventListener('resize', vcMedir);
  window.addEventListener('orientationchange', () => setTimeout(vcMedir, 260));
  window.addEventListener('carrinho-atualizado', vcContador);
  document.addEventListener('astro:page-load', vcInit);
</script>
