---
import '../../../styles/global.css';
import 'quill/dist/quill.snow.css';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Editar Produto - Vivi Correa</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #f4f4f5; margin: 0; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }
        .bg-brand { background-color: #8B7355; }
        .ql-container { font-family: 'Montserrat', sans-serif; font-size: 14px; }
        .ql-editor { min-height: 200px; }
        
        /* 🎨 GALERIA DE IMAGENS */
        .galeria-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }
        .galeria-item {
            position: relative;
            aspect-ratio: 1;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
            background: #f9fafb;
            transition: all 0.3s ease;
        }
        .galeria-item.principal {
            border-color: #8B7355;
            box-shadow: 0 0 0 2px rgba(139, 115, 85, 0.2);
        }
        .galeria-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .galeria-acoes {
            position: absolute;
            top: 4px;
            right: 4px;
            display: flex;
            gap: 4px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .galeria-item:hover .galeria-acoes {
            opacity: 1;
        }
        .galeria-btn {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: bold;
            transition: all 0.2s ease;
        }
        .galeria-btn:hover {
            transform: scale(1.1);
        }
        .btn-remover {
            background: #ef4444;
            color: white;
        }
        .btn-mover {
            background: #6b7280;
            color: white;
        }
        .badge-principal {
            position: absolute;
            bottom: 4px;
            left: 4px;
            background: #8B7355;
            color: white;
            font-size: 9px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .upload-area {
            border: 2px dashed #d1d5db;
            border-radius: 8px;
            padding: 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #f9fafb;
        }
        .upload-area:hover {
            border-color: #8B7355;
            background: #fef9f3;
        }
        .upload-area.dragover {
            border-color: #8B7355;
            background: #fef3c7;
        }
        .upload-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }
        .upload-progress {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: #dbeafe;
            border-radius: 6px;
            font-size: 13px;
            color: #1e40af;
        }
        .upload-progress.show {
            display: block;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-gray-900 text-white flex flex-col">
        <div class="p-6 text-center border-b border-gray-800">
            <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Vivi Correa" class="h-16 mx-auto brightness-0 invert" />
            <p class="text-xs uppercase tracking-widest mt-2 text-gray-400">Admin</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <a href={`${import.meta.env.BASE_URL}admin`} class="block px-4 py-3 bg-gray-800 rounded text-brand font-semibold">Produtos</a>
            <a href={`${import.meta.env.BASE_URL}admin/pedidos`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Pedidos</a>
            <a href={`${import.meta.env.BASE_URL}admin/config`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Configurações (Banner)</a>
            <a href={`${import.meta.env.BASE_URL}admin/conteudo`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Conteúdo do Site</a>
        </nav>
    </aside>

    <main class="flex-1 overflow-y-auto p-8">
        <div class="max-w-4xl mx-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-3xl" id="titulo-pagina">Carregando...</h2>
                <a href={`${import.meta.env.BASE_URL}admin`} class="text-gray-500 hover:text-gray-800 text-sm">← Voltar</a>
            </div>

            <form id="form-produto" class="bg-white p-8 rounded-lg shadow space-y-6">
                
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Nome da Peça</label>
                        <input type="text" id="nome" required class="w-full border p-3 rounded bg-gray-50 focus:bg-white transition">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Preço (R$)</label>
                        <input type="number" id="preco" step="0.01" required class="w-full border p-3 rounded bg-gray-50 focus:bg-white transition">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Categoria</label>
                        <select id="categoria" class="w-full border p-3 rounded bg-gray-50">
                            <option value="Anéis">Anéis</option>
                            <option value="Brincos">Brincos</option>
                            <option value="Colares">Colares</option>
                            <option value="Kits de Produtos para presentear">Kits</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Coleção (Opcional)</label>
                        <input type="text" id="colecao" class="w-full border p-3 rounded bg-gray-50 focus:bg-white transition" placeholder="Ex: Abrolhos, Origens...">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Numeração (Apenas para anéis)</label>
                    <input type="text" id="numeracao" class="w-full border p-3 rounded bg-gray-50 focus:bg-white transition" placeholder="Ex: 14, 16, 18 ou 14 ao 20">
                </div>

                <!-- 📸 NOVA GALERIA UNIFICADA -->
                <div class="border-t pt-4 mt-4">
                    <label class="block text-sm font-semibold mb-3">📸 Fotos da Peça</label>
                    <p class="text-xs text-gray-500 mb-3">A primeira foto será a imagem principal. Você pode reordenar usando as setas ↑ ↓</p>
                    
                    <!-- Área de Upload -->
                    <div class="upload-area" id="upload-area">
                        <div class="upload-icon">📤</div>
                        <p class="text-sm font-semibold text-gray-700">Clique aqui ou arraste as fotos</p>
                        <p class="text-xs text-gray-500 mt-1">Você pode selecionar várias de uma vez</p>
                        <input type="file" id="input-imagens" accept="image/*" multiple class="hidden">
                    </div>
                    
                    <!-- Progresso do Upload -->
                    <div id="upload-progress" class="upload-progress">
                        ⏳ Enviando imagens... <span id="progress-text">0/0</span>
                    </div>
                    
                    <!-- Grid de Imagens -->
                    <div id="galeria-container" class="galeria-grid"></div>
                    
                    <p id="sem-imagens" class="text-sm text-gray-400 text-center mt-4">Nenhuma foto adicionada ainda</p>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Descrição Rica</label>
                    <div id="editor-descricao"></div>
                </div>

                <div class="flex items-center gap-3">
                    <input type="checkbox" id="destaque" class="w-5 h-5 accent-brand">
                    <label class="text-sm font-semibold">Mostrar na vitrine da Home (Destaque)</label>
                </div>

                <div class="flex justify-end gap-4 pt-4 border-t">
                    <button type="button" id="btn-excluir" class="px-6 py-2 text-red-600 border border-red-200 rounded hover:bg-red-50 hidden">Excluir Peça</button>
                    <button type="submit" class="bg-brand text-white px-8 py-3 rounded font-bold uppercase tracking-wider text-sm hover:bg-[#7a654b] transition shadow">Salvar Produto</button>
                </div>
                <p id="msg-sucesso" class="text-green-600 text-sm text-right hidden font-bold">Salvo com sucesso!</p>
            </form>
        </div>
    </main>

    <script>
        import { createClient } from '@supabase/supabase-js';
        import Quill from 'quill';

        const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

        // Pega o ID da URL (?id=123)
        const urlParams = new URLSearchParams(window.location.search);
        const produtoId = urlParams.get('id');
        const isNovo = !produtoId;

        const quill = new Quill('#editor-descricao', {
            theme: 'snow',
            placeholder: 'Descreva os detalhes, materiais e história da peça...',
            modules: { toolbar: [['bold', 'italic', 'underline'], [{ 'list': 'ordered'}, { 'list': 'bullet' }], ['link'], ['clean']] }
        });

        // 🎯 ARRAY INTERNO PARA GERENCIAR TODAS AS IMAGENS
        let imagens = [];

        async function carregarDados() {
            if (isNovo) {
                document.getElementById('titulo-pagina').innerText = 'Adicionar Nova Peça';
                return;
            }
            
            document.getElementById('titulo-pagina').innerText = 'Editar Peça';
            document.getElementById('btn-excluir').classList.remove('hidden');

            const { data: prod } = await supabase.from('produtos').select('*').eq('id', produtoId).single();
            
            if (prod) {
                document.getElementById('nome').value = prod.nome;
                document.getElementById('preco').value = prod.preco_centavos / 100;
                document.getElementById('categoria').value = prod.categoria || 'Anéis';
                document.getElementById('colecao').value = prod.colecao || '';
                document.getElementById('numeracao').value = prod.numeracao || '';
                document.getElementById('destaque').checked = prod.destaque;
                quill.root.innerHTML = prod.descricao || '';
                
                // 🔥 LÓGICA INTELIGENTE: Detecta se imagem_url é string ou array JSON
                if (prod.imagem_url) {
                    if (typeof prod.imagem_url === 'string') {
                        try {
                            const parsed = JSON.parse(prod.imagem_url);
                            imagens = Array.isArray(parsed) ? parsed : [prod.imagem_url];
                        } catch {
                            imagens = [prod.imagem_url];
                        }
                    } else if (Array.isArray(prod.imagem_url)) {
                        imagens = prod.imagem_url;
                    }
                    renderizarGaleria();
                }
            }
        }
        carregarDados();

        // 🎨 RENDERIZAR GALERIA
        function renderizarGaleria() {
            const container = document.getElementById('galeria-container');
            const semImagens = document.getElementById('sem-imagens');
            
            if (imagens.length === 0) {
                container.innerHTML = '';
                semImagens.classList.remove('hidden');
                return;
            }
            
            semImagens.classList.add('hidden');
            container.innerHTML = '';
            
            imagens.forEach((url, index) => {
                const isPrincipal = index === 0;
                const item = document.createElement('div');
                item.className = `galeria-item ${isPrincipal ? 'principal' : ''}`;
                item.innerHTML = `
                    <img src="${url}" alt="Foto ${index + 1}">
                    <div class="galeria-acoes">
                        ${index > 0 ? `<button type="button" class="galeria-btn btn-mover" onclick="moverImagem(${index}, -1)" title="Mover para cima">↑</button>` : ''}
                        ${index < imagens.length - 1 ? `<button type="button" class="galeria-btn btn-mover" onclick="moverImagem(${index}, 1)" title="Mover para baixo">↓</button>` : ''}
                        <button type="button" class="galeria-btn btn-remover" onclick="removerImagem(${index})" title="Remover">×</button>
                    </div>
                    ${isPrincipal ? '<div class="badge-principal">Principal</div>' : ''}
                `;
                container.appendChild(item);
            });
        }

        // 🔄 REORDENAR IMAGENS
        window.moverImagem = (index, direcao) => {
            const novoIndex = index + direcao;
            if (novoIndex < 0 || novoIndex >= imagens.length) return;
            [imagens[index], imagens[novoIndex]] = [imagens[novoIndex], imagens[index]];
            renderizarGaleria();
        };

        // 🗑️ REMOVER IMAGEM
        window.removerImagem = (index) => {
            if (confirm('Deseja remover esta foto?')) {
                imagens.splice(index, 1);
                renderizarGaleria();
            }
        };

        // 📤 UPLOAD DE IMAGENS
        const uploadArea = document.getElementById('upload-area');
        const inputImagens = document.getElementById('input-imagens');
        const uploadProgress = document.getElementById('upload-progress');
        const progressText = document.getElementById('progress-text');

        // Clique na área abre o seletor
        uploadArea.addEventListener('click', () => inputImagens.click());

        // Drag and drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length > 0) processarUpload(files);
        });

        // Seleção de arquivos
        inputImagens.addEventListener('change', (e) => {
            const files = e.target.files;
            if (files.length > 0) processarUpload(files);
        });

        // 🚀 PROCESSAR UPLOAD
        async function processarUpload(files) {
            uploadProgress.classList.add('show');
            progressText.innerText = `0/${files.length}`;
            
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const fileName = `produto-${Date.now()}-${i}.${file.name.split('.').pop()}`;
                
                progressText.innerText = `${i + 1}/${files.length}`;
                
                const { error } = await supabase.storage.from('produtos').upload(fileName, file);
                
                if (!error) {
                    const { data } = supabase.storage.from('produtos').getPublicUrl(fileName);
                    imagens.push(data.publicUrl);
                } else {
                    alert(`Erro ao enviar ${file.name}: ${error.message}`);
                }
            }
            
            renderizarGaleria();
            uploadProgress.classList.remove('show');
            inputImagens.value = '';
        }

        // 💾 SALVAR PRODUTO
        document.getElementById('form-produto').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = 'Salvando...';
            btn.disabled = true;

            // Validação: precisa ter pelo menos 1 imagem
            if (imagens.length === 0) {
                alert('Adicione pelo menos uma foto da peça antes de salvar.');
                btn.innerText = 'Salvar Produto';
                btn.disabled = false;
                return;
            }

            const nome = document.getElementById('nome').value;
            const precoCentavos = Math.round(parseFloat(document.getElementById('preco').value) * 100);
            const categoria = document.getElementById('categoria').value;
            const colecao = document.getElementById('colecao').value;
            const numeracao = document.getElementById('numeracao').value;
            const destaque = document.getElementById('destaque').checked;
            const descricao = quill.root.innerHTML;

            // 🔥 LÓGICA DE UNIFICAÇÃO: 1 foto = string, 2+ fotos = array JSON
            let imagemUrlFinal;
            if (imagens.length === 1) {
                imagemUrlFinal = imagens[0]; // String simples (compatível com produtos antigos)
            } else {
                imagemUrlFinal = JSON.stringify(imagens); // Array JSON
            }

            const payload = { 
                nome, 
                preco_centavos: precoCentavos, 
                categoria, 
                colecao, 
                numeracao, 
                destaque, 
                descricao, 
                imagem_url: imagemUrlFinal
                // galeria_urls removido (não existe no banco)
            };

            let error;
            if (isNovo) {
                const { error: err } = await supabase.from('produtos').insert([payload]);
                error = err;
            } else {
                const { error: err } = await supabase.from('produtos').update(payload).eq('id', produtoId);
                error = err;
            }

            if (error) {
                alert('Erro ao salvar: ' + error.message);
                btn.innerText = 'Salvar Produto';
                btn.disabled = false;
            } else {
                document.getElementById('msg-sucesso').classList.remove('hidden');
                setTimeout(() => { window.location.href = import.meta.env.BASE_URL + 'admin'; }, 1500);
            }
        });

        document.getElementById('btn-excluir').addEventListener('click', async () => {
            if (confirm('Tem certeza que deseja excluir esta peça?')) {
                await supabase.from('produtos').delete().eq('id', produtoId);
                window.location.href = import.meta.env.BASE_URL + 'admin';
            }
        });
    </script>
</body>
</html>
