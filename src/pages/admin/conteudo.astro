---
import '../../styles/global.css';
import '../../styles/admin.css';
import '../../styles/admin.css';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Conteúdo do Site - Vivi Correa</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #f4f4f5; margin: 0; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }
        .bg-brand { background-color: #8B7355; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">
    <button class="admin-burger" id="admin-burger" aria-label="Abrir menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg></button>
    <div class="admin-scrim" id="admin-scrim"></div>
    <button class="admin-burger" id="admin-burger" aria-label="Abrir menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="admin-scrim" id="admin-scrim"></div>

    <aside class="w-64 bg-gray-900 text-white flex flex-col">
        <div class="p-6 text-center border-b border-gray-800">
            <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Vivi Correa" class="h-12 mx-auto brightness-0 invert" />
            <p class="text-xs uppercase tracking-widest mt-2 text-gray-400">Admin</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <a href={`${import.meta.env.BASE_URL}admin`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Produtos</a>
            <a href={`${import.meta.env.BASE_URL}admin/pedidos`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Pedidos</a>
            <a href={`${import.meta.env.BASE_URL}admin/config`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Configurações (Banner)</a>
            <a href={`${import.meta.env.BASE_URL}admin/conteudo`} class="block px-4 py-3 bg-gray-800 rounded text-brand font-semibold">Conteúdo do Site</a>
        </nav>
        <div class="p-4 border-t border-gray-800">
            <a href={`${import.meta.env.BASE_URL}`} target="_blank" class="block text-center text-sm text-gray-400 hover:text-white transition">Ver Loja Online ↗</a>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl mb-8">Conteúdo das Páginas</h2>
            
            <div class="bg-white p-8 rounded-lg shadow text-center">
                <h3 class="text-xl mb-4">Em breve!</h3>
                <p class="text-gray-500 text-sm">
                    Aqui a Vivi poderá editar os textos da página "Quem Somos" e "Ajuda/Políticas" diretamente pelo painel.
                </p>
            </div>
        </div>
    </main>
    <script>
      const burger = document.getElementById("admin-burger");
      const aside = document.querySelector("aside");
      const scrim = document.getElementById("admin-scrim");
      
      function toggleMenu() {
        aside.classList.toggle("aberto");
        scrim.classList.toggle("visivel");
      }
      
      burger?.addEventListener("click", toggleMenu);
      scrim?.addEventListener("click", toggleMenu);
      
      // Fecha menu ao clicar em um link
      aside?.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 900) {
            aside.classList.remove("aberto");
            scrim.classList.remove("visivel");
          }
        });
      });
    </script>
    <script>
      const burger = document.getElementById("admin-burger");
      const aside = document.querySelector("aside");
      const scrim = document.getElementById("admin-scrim");
      function toggleMenu() { aside.classList.toggle("aberto"); scrim.classList.toggle("visivel"); }
      burger?.addEventListener("click", toggleMenu);
      scrim?.addEventListener("click", toggleMenu);
      aside?.querySelectorAll("a").forEach(link => { link.addEventListener("click", () => { if (window.innerWidth < 900) { aside.classList.remove("aberto"); scrim.classList.remove("visivel"); } }); });
    </script>
</body>
</html>