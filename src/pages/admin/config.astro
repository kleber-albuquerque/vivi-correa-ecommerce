---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Configurações - Vivi Correa</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #f4f4f5; margin: 0; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }
        .bg-brand { background-color: #8B7355; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">
    <aside class="w-64 bg-gray-900 text-white flex flex-col">
        <div class="p-6 text-center border-b border-gray-800">
            <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Vivi Correa" class="h-12 mx-auto brightness-0 invert" />
            <p class="text-xs uppercase tracking-widest mt-2 text-gray-400">Admin</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <a href={`${import.meta.env.BASE_URL}admin`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Produtos</a>
            <a href={`${import.meta.env.BASE_URL}admin/pedidos`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Pedidos</a>
            <a href={`${import.meta.env.BASE_URL}admin/config`} class="block px-4 py-3 bg-gray-800 rounded text-brand font-semibold">Configurações (Banner)</a>
            <a href={`${import.meta.env.BASE_URL}admin/conteudo`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Conteúdo do Site</a>
        </nav>
    </aside>

    <main class="flex-1 overflow-y-auto p-8">
        <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl mb-8">Configurações da Loja</h2>
            
            <div class="bg-white p-8 rounded-lg shadow">
                <h3 class="text-2xl mb-4">Banners da Página Inicial</h3>
                
                <div id="lista-banners" class="flex flex-wrap gap-4 mb-6">
                    <!-- Banners aparecerão aqui -->
                </div>

                <div class="mb-6 bg-gray-50 p-4 border rounded">
                    <label class="block text-sm font-semibold mb-2">Subir nova imagem (o upload é automático):</label>
                    <input type="file" id="upload-banner" accept="image/*" class="text-sm w-full p-2 bg-white border rounded cursor-pointer">
                </div>

                <button id="salvar-tudo" type="button" class="bg-brand text-white px-8 py-3 rounded font-bold uppercase tracking-wider text-sm hover:bg-[#7a654b] transition shadow w-full">Salvar Banners</button>
                <p id="msg-banner" class="text-green-600 text-sm mt-3 hidden font-bold text-center">Banners atualizados com sucesso!</p>
            </div>
        </div>
    </main>

    <script>
        import { createClient } from '@supabase/supabase-js';

        const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

        let bannersParaSalvar = [];

        async function carregarBanners() {
            const { data } = await supabase.from('configuracoes').select('valor').eq('chave', 'banner_home').single();
            if (data && data.valor) {
                try {
                    bannersParaSalvar = JSON.parse(data.valor);
                    if (!Array.isArray(bannersParaSalvar)) bannersParaSalvar = [data.valor];
                } catch {
                    bannersParaSalvar = [data.valor];
                }
            }
            renderizarBanners();
        }

        function renderizarBanners() {
            const container = document.getElementById('lista-banners');
            container.innerHTML = '';
            
            if (bannersParaSalvar.length === 0) {
                container.innerHTML = '<p class="text-gray-400 text-sm italic">Nenhum banner configurado.</p>';
                return;
            }

            bannersParaSalvar.forEach((url, index) => {
                const div = document.createElement('div');
                div.className = "relative min-w-[200px] h-24 bg-gray-200 rounded border overflow-hidden group";
                div.innerHTML = `
                    <img src="${url}" class="w-full h-full object-cover" />
                    <button onclick="removerBanner(${index})" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition shadow">×</button>
                `;
                container.appendChild(div);
            });
        }

        window.removerBanner = (index) => {
            bannersParaSalvar.splice(index, 1);
            renderizarBanners();
        };

        // O UPLOAD ACONTECE AQUI, ASSIM QUE O ARQUIVO É ESCOLHIDO
        document.getElementById('upload-banner').addEventListener('change', async (e) => {
            const arquivo = e.target.files[0];
            if (!arquivo) return;

            const input = e.target;
            input.disabled = true; // Bloqueia o input enquanto envia

            const fileName = `banner-${Date.now()}.${arquivo.name.split('.').pop()}`;
            const { error } = await supabase.storage.from('produtos').upload(fileName, arquivo);
            
            if (!error) {
                const { data } = supabase.storage.from('produtos').getPublicUrl(fileName);
                bannersParaSalvar.push(data.publicUrl);
                renderizarBanners();
                input.value = ''; // Limpa o campo
            } else {
                alert("Erro no upload: " + error.message);
            }
            
            input.disabled = false;
        });

        document.getElementById('salvar-tudo').addEventListener('click', async () => {
            const btn = document.getElementById('salvar-tudo');
            btn.innerText = 'Salvando...';
            
            const valorJson = JSON.stringify(bannersParaSalvar);
            const { error } = await supabase.from('configuracoes').update({ valor: valorJson }).eq('chave', 'banner_home');
            
            if (!error) {
                document.getElementById('msg-banner').classList.remove('hidden');
                setTimeout(() => document.getElementById('msg-banner').classList.add('hidden'), 3000);
            } else {
                alert("Erro ao salvar: " + error.message);
            }
            btn.innerText = 'Salvar Banners';
        });

        carregarBanners();
    </script>
</body>
</html>