---
import '../../styles/global.css';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: pedidos } = await supabase.from('pedidos').select('*').order('criado_em', { ascending: false });
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Pedidos - Vivi Correa</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #f4f4f5; margin: 0; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }
        .bg-brand { background-color: #8B7355; }
    </style>
</head>
<body class="flex h-screen overflow-hidden text-gray-800">

    <aside class="w-64 bg-gray-900 text-white flex flex-col">
        <div class="p-6 text-center border-b border-gray-800">
            <img src={`${import.meta.env.BASE_URL}logo.png`} alt="Vivi Correa" class="h-12 mx-auto brightness-0 invert" />
            <p class="text-xs uppercase tracking-widest mt-2 text-gray-400">Admin</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <a href={`${import.meta.env.BASE_URL}admin`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Produtos</a>
            <a href={`${import.meta.env.BASE_URL}admin/pedidos`} class="block px-4 py-3 bg-gray-800 rounded text-brand font-semibold">Pedidos</a>
            <a href={`${import.meta.env.BASE_URL}admin/config`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Configurações (Banner)</a>
            <a href={`${import.meta.env.BASE_URL}admin/conteudo`} class="block px-4 py-3 hover:bg-gray-800 rounded transition text-gray-300">Conteúdo do Site</a>
        </nav>
        <div class="p-4 border-t border-gray-800">
            <a href={`${import.meta.env.BASE_URL}`} target="_blank" class="block text-center text-sm text-gray-400 hover:text-white transition">Ver Loja Online ↗</a>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-8">
        <h2 class="text-3xl mb-8">Gerenciar Pedidos</h2>

        {pedidos?.length === 0 && (
            <div class="bg-white p-8 rounded-lg shadow text-center text-gray-500">
                Nenhum pedido realizado ainda.
            </div>
        )}

        <div class="space-y-4">
            {pedidos?.map(pedido => (
                <details class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden group">
                    <summary class="flex justify-between items-center p-6 cursor-pointer hover:bg-gray-50 transition list-none">
                        <div>
                            <h3 class="font-bold text-lg text-gray-900">{pedido.cliente_nome}</h3>
                            <p class="text-sm text-gray-500">
                                {new Date(pedido.criado_em).toLocaleString('pt-BR')} 
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="text-brand font-bold text-lg">
                                {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(pedido.total_centavos / 100)}
                            </p>
                            <span class="text-xs uppercase tracking-widest text-gray-400 group-open:hidden">Ver detalhes ↓</span>
                        </div>
                    </summary>
                    
                    <div class="px-6 pb-6 border-t border-gray-50 pt-4 bg-gray-50/50">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <h4 class="font-semibold text-sm mb-2 text-gray-700 uppercase tracking-wider">Dados do Cliente</h4>
                                <ul class="text-sm text-gray-600 space-y-1">
                                    <li><strong>Telefone:</strong> {pedido.cliente_telefone}</li>
                                    <li><strong>E-mail:</strong> {pedido.cliente_email}</li>
                                    <li><strong>CPF:</strong> {pedido.cliente_cpf}</li>
                                </ul>
                                
                                <h4 class="font-semibold text-sm mb-2 mt-4 text-gray-700 uppercase tracking-wider">Endereço</h4>
                                <p class="text-sm text-gray-600">
                                    {pedido.endereco_rua}, {pedido.endereco_numero} {pedido.endereco_complemento && `- ${pedido.endereco_complemento}`}<br>
                                    {pedido.endereco_bairro} - {pedido.endereco_cidade}/{pedido.endereco_estado}<br>
                                    CEP: {pedido.endereco_cep}
                                </p>
                            </div>
                            <div>
                                <h4 class="font-semibold text-sm mb-2 text-gray-700 uppercase tracking-wider">Itens</h4>
                                <ul class="space-y-3">
                                    {pedido.itens.map(item => (
                                        <li class="flex items-center gap-3 bg-white p-2 rounded border border-gray-100">
                                            <img src={item.imagem} class="w-10 h-10 object-cover rounded">
                                            <div class="flex-1">
                                                <p class="font-semibold text-sm text-gray-800">{item.nome}</p>
                                                <p class="text-xs text-gray-500">Qtd: {item.quantidade}</p>
                                            </div>
                                            <p class="text-sm font-medium text-gray-700">
                                                {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.preco * item.quantidade)}
                                            </p>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </div>
                </details>
            ))}
        </div>
    </main>
</body>
</html>