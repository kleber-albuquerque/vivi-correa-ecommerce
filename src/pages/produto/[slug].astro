---
import { createClient } from '@supabase/supabase-js';
import '../../styles/global.css';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const { data: produtos } = await supabase.from('produtos').select('id, nome');

  return produtos?.map((produto) => {
    const slug = produto.nome.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    return { params: { slug: slug }, props: { produtoId: produto.id } };
  }) || [];
}

const { produtoId } = Astro.props;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);

const { data: produto } = await supabase
  .from('produtos')
  .select('*')
  .eq('id', produtoId)
  .single();
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>{produto.nome} - Vivi Correa</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #faf9f7; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }

        /* Efeito de Zoom na Imagem */
        .zoom-container {
            overflow: hidden;
            cursor: zoom-in;
        }
        .zoom-image {
            transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .zoom-container:hover .zoom-image {
            transform: scale(1.15);
        }

        /* Botão de Compra Premium */
        .btn-buy {
            transition: all 0.3s ease;
            background-color: #1a1a1a;
        }
        .btn-buy:hover {
            background-color: #8B7355;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(139, 115, 85, 0.3);
        }

        /* Seletor de Numeração */
        .size-btn {
            border: 1px solid #d1d5db;
            transition: all 0.2s;
        }
        .size-btn:hover {
            border-color: #8B7355;
            color: #8B7355;
        }
        .size-btn.active {
            background-color: #8B7355;
            border-color: #8B7355;
            color: white;
        }
    </style>
</head>
<body class="text-gray-800 antialiased" data-pagefind-body>

    <Header />

    <!-- Breadcrumb -->
    <div class="container mx-auto px-6 py-6 text-xs uppercase tracking-widest text-gray-400">
        <a href="/" class="hover:text-brand transition">Início</a>
        <span class="mx-2">/</span>
        <a href={`/${produto.categoria.toLowerCase()}`} class="hover:text-brand transition">{produto.categoria}</a>
        <span class="mx-2">/</span>
        <span class="text-gray-600">{produto.nome}</span>
    </div>

    <main class="container mx-auto px-6 pb-20">
        <div class="flex flex-col lg:flex-row gap-12 items-start">

            <!-- Imagem Principal com Zoom -->
            <div class="lg:w-3/5 w-full">
                <div class="bg-gray-100 rounded-sm overflow-hidden aspect-square relative zoom-container shadow-sm">
                    <img src={produto.imagem_url} alt={produto.nome} class="w-full h-full object-cover zoom-image" />
                </div>

                <!-- Miniaturas (se existirem fotos extras) -->
                {produto.galeria_urls && produto.galeria_urls.length > 0 && (
                    <div class="flex gap-3 mt-4 overflow-x-auto hide-scrollbar">
                        <div class="w-20 h-20 flex-shrink-0 border-2 border-brand rounded-sm overflow-hidden cursor-pointer bg-gray-50">
                            <img src={produto.imagem_url} class="w-full h-full object-cover" />
                        </div>
                        {produto.galeria_urls.map((url) => (
                            <div class="w-20 h-20 flex-shrink-0 border border-gray-200 rounded-sm overflow-hidden cursor-pointer bg-gray-50 hover:border-brand transition">
                                <img src={url} class="w-full h-full object-cover" />
                            </div>
                        ))}
                    </div>
                )}
            </div>

            <!-- Informações do Produto -->
            <div class="lg:w-2/5 w-full text-center lg:text-left">
                <p class="text-xs uppercase tracking-[0.2em] text-brand mb-3 font-semibold">
                    {produto.colecao || "Joia Autoral"}
                </p>
                <h1 class="text-4xl lg:text-5xl text-gray-900 mb-4 leading-tight">{produto.nome}</h1>

                <p class="text-2xl text-gray-800 font-light mb-8">
                    {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(produto.preco_centavos / 100)}
                </p>

                <!-- Seletor de Numeração -->
                {produto.numeracao && (
                    <div class="mb-8 bg-white p-4 rounded-sm border border-gray-100 shadow-sm">
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-semibold text-gray-700 uppercase tracking-widest">Tamanho</p>
                            <a href="/ajuda" class="text-xs text-brand underline">Guia de medidas</a>
                        </div>
                        <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
                            <button class="size-btn active px-4 py-2 text-sm rounded-sm">
                                {produto.numeracao}
                            </button>
                        </div>
                    </div>
                )}

                <!-- Descrição Rica -->
                <div class="text-gray-600 leading-relaxed mb-8 text-sm whitespace-pre-line bg-white p-6 rounded-sm border border-gray-100 shadow-sm">
                    {produto.descricao || "Joia artesanal exclusiva Vivi Correa. Cada peça é única e feita à mão com carinho."}
                </div>

                <!-- Botão de Comprar -->
                <button id="btn-add-carrinho" class="btn-buy w-full text-white py-5 px-8 uppercase tracking-[0.2em] text-sm font-bold rounded-sm">
                    Adicionar ao Carrinho
                </button>

                <div class="mt-6 flex items-center justify-center lg:justify-start gap-2 text-xs text-gray-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span>Feito à mão sob encomenda</span>
                </div>
                <div class="mt-2 flex items-center justify-center lg:justify-start gap-2 text-xs text-gray-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <span>Embalagem exclusiva e segura</span>
                </div>
            </div>

        </div>
    </main>

    <footer class="bg-gray-900 text-white py-16 text-center text-sm">
        <img src="/logo.png" alt="Vivi Correa" class="h-12 mx-auto mb-6 brightness-0 invert opacity-50" />
        <div class="flex justify-center gap-6 mb-8 text-gray-400">
            <a href="/quem-somos" class="hover:text-white transition">Quem Somos</a>
            <a href="/ajuda" class="hover:text-white transition">Ajuda & Políticas</a>
            <a href="https://wa.me/5571991064721" target="_blank" class="hover:text-white transition">Fale Conosco</a>
        </div>
        <p class="text-gray-500 text-xs">&copy; 2026 Vivi Correa. Todos os direitos reservados.</p>
    </footer>

    <div id="dados-produto"
         data-id={produto.id}
         data-nome={produto.nome}
         data-preco={produto.preco_centavos / 100}
         data-imagem={produto.imagem_url}
         class="hidden">
    </div>

    <script>
        // Lógica de Adicionar ao Carrinho (mantida)
        document.getElementById('btn-add-carrinho').addEventListener('click', () => {
            const divDados = document.getElementById('dados-produto');
            const produto = {
                id: divDados.dataset.id,
                nome: divDados.dataset.nome,
                preco: parseFloat(divDados.dataset.preco),
                imagem: divDados.dataset.imagem
            };

            let carrinho = JSON.parse(localStorage.getItem('carrinho_vivi')) || [];
            const itemExistente = carrinho.find(item => item.id === produto.id);

            if (itemExistente) {
                itemExistente.quantidade += 1;
            } else {
                produto.quantidade = 1;
                carrinho.push(produto);
            }

            localStorage.setItem('carrinho_vivi', JSON.stringify(carrinho));

            const btn = document.getElementById('btn-add-carrinho');
            btn.innerText = "Adicionado! ✓";
            btn.classList.replace('bg-gray-900', 'bg-green-600');

            setTimeout(() => {
                btn.innerText = "Adicionar ao Carrinho";
                btn.classList.replace('bg-green-600', 'bg-gray-900');
            }, 2000);
        });

        // Lógica de trocar a imagem principal ao clicar na miniatura (se houver)
        const thumbnails = document.querySelectorAll('.zoom-container img');
        // (A lógica de galeria será implementada quando tivermos as imagens)
    </script>
</body>
</html>
