    .sc-toast.on{transform:none}
  }
  @media (prefers-reduced-motion:reduce){ .sc *,.sc *::before,.sc *::after{animation:none!important;transition:none!important} .sc-hero,.sc-tools,.sc-painel,.sc-secao{opacity:1;transform:none} }
</style>
