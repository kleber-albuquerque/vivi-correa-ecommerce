<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
  const BASE = import.meta.env.BASE_URL;
  const K = { cart:'carrinho_vivi', save:'desejos_vivi', sel:'selecao_vivi', cup:'cupom_vivi', cep:'cep_vivi', ord:'ordem_vivi' };
  const $ = id => document.getElementById(id);
  const brl = v => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(v||0);
  const soD = v => String(v||'').replace(/\D/g,'');
  const mCEP = v => { v = soD(v).slice(0,8); return v.length>5 ? v.slice(0,5)+'-'+v.slice(5) : v; };
  const slug = s => String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
  const ler = (k, fb) => { try { const v = JSON.parse(localStorage.getItem(k)); return v ?? fb; } catch(e){ return fb; } };
  const gravar = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} };

  function imgsDe(bruto, fallback){
    let a = [];
    if (typeof bruto === 'string' && bruto.trim()){
      try { const j = JSON.parse(bruto); a = Array.isArray(j) ? j.filter(Boolean) : [bruto]; } catch(e){ a = [bruto]; }
    } else if (Array.isArray(bruto)) a = bruto.filter(Boolean);
    return a.length ? a : [fallback];
  }
  const minimo = i => ({ id:i.id, nome:i.nome, preco:i.preco, imagem:i.imagem, quantidade:i.quantidade });

  let itens = [], salvos = [], sel = new Set(), busca = '', ordem = 'manual', cupom = null, freteCfg = null, cepInfo = null, gavetaId = null, arrasteIdx = null, desfazer = null, toastT = null, hidratado = false;

  function carregar(){
    const bruto = ler(K.cart, []);
    itens = (Array.isArray(bruto)?bruto:[]).filter(i=>i&&i.nome).map(i=>({
      id:i.id, nome:i.nome, preco:parseFloat(i.preco)||0, imagem:i.imagem||'', quantidade:Math.max(1,parseInt(i.quantidade)||1),
      categoria:i.categoria||'', colecao:i.colecao||'', descricao:i.descricao||'', numeracao:i.numeracao||'',
      estoque:(i.estoque===null||i.estoque===undefined)?null:parseInt(i.estoque), imagens:imgsDe(i.imagem, `${BASE}logo.png`)
    }));
    const sv = ler(K.save, []);
    salvos = (Array.isArray(sv)?sv:[]).filter(i=>i&&i.nome).map(i=>({ ...i, preco:parseFloat(i.preco)||0, quantidade:Math.max(1,parseInt(i.quantidade)||1) }));
    const s = ler(K.sel, null);
    sel = new Set(Array.isArray(s) && s.length ? s.map(String) : itens.map(i=>String(i.id)));
    itens.forEach(i=>{ if(!sel.has(String(i.id))) sel.delete(String(i.id)); });
    if (!Array.isArray(s)) sel = new Set(itens.map(i=>String(i.id)));
    cupom = ler(K.cup, null);
    ordem = ler(K.ord, 'manual');
    const c = ler(K.cep, null);
    if (c && c.cep){ cepInfo = c; $('sc-cep').value = mCEP(c.cep); }
    if ($('sc-ordem')) $('sc-ordem').value = ordem;
  }
  function persistir(){
    gravar(K.cart, itens.map(minimo));
    gravar(K.save, salvos.map(minimo));
    gravar(K.sel, Array.from(sel));
    gravar(K.cup, cupom);
    gravar(K.ord, ordem);
    gravar(K.cep, cepInfo);
    window.dispatchEvent(new CustomEvent('carrinho-atualizado'));
  }

  async function hidratar(){
    if (!itens.length){ hidratado = true; render(); return; }
    try{
      const ids = itens.map(i=>i.id).filter(v=>v!==undefined&&v!==null);
      const { data, error } = await supabase.from('produtos').select('*').in('id', ids);
      if (!error && Array.isArray(data)){
        itens = itens.map(i=>{
          const p = data.find(d=>String(d.id)===String(i.id));
          if (!p) return { ...i, indisponivel:true };
          const imgs = imgsDe(p.imagem_url, `${BASE}logo.png`);
          return { ...i, nome:p.nome, preco:(p.preco_centavos||0)/100, imagem:imgs[0], imagens:imgs,
            categoria:p.categoria||'', colecao:p.colecao||'', descricao:p.descricao||'', numeracao:p.numeracao||'',
            estoque:(p.estoque===null||p.estoque===undefined)?null:parseInt(p.estoque), indisponivel:false };
        });
      }
    }catch(e){}
    hidratado = true; persistir(); render();
  }
  async function configuracoes(){
    try{
      const { data } = await supabase.from('configuracoes').select('chave,valor').in('chave',['frete_gratis_acima','cupom_desconto']);
      (data||[]).forEach(r=>{
        if (r.chave === 'frete_gratis_acima'){
          const n = parseFloat(String(r.valor).replace(/[^\d.,]/g,'').replace(',','.'));
          if (!isNaN(n) && n > 0) freteCfg = n > 1000 ? n/100 : n;
        }
        if (r.chave === 'cupom_desconto'){
          try { const j = JSON.parse(r.valor); if (j && j.codigo) cupomCfg = j; } catch(e){}
        }
      });
    }catch(e){}
    render();
  }
  let cupomCfg = null;

  const maxDe = i => (i.estoque === null || isNaN(i.estoque)) ? 99 : Math.max(0, i.estoque);
  const visiveis = () => {
    let l = itens.slice();
    if (busca.trim()){ const q = busca.trim().toLowerCase(); l = l.filter(i => (i.nome+' '+i.colecao+' '+i.categoria).toLowerCase().includes(q)); }
    if (ordem==='nome') l.sort((a,b)=>a.nome.localeCompare(b.nome,'pt-BR'));
    if (ordem==='caro') l.sort((a,b)=>(b.preco*b.quantidade)-(a.preco*a.quantidade));
    if (ordem==='barato') l.sort((a,b)=>(a.preco*a.quantidade)-(b.preco*b.quantidade));
    if (ordem==='qtd') l.sort((a,b)=>b.quantidade-a.quantidade);
    return l;
  };
  const escolhidos = () => itens.filter(i=>sel.has(String(i.id)));
  const subtotal = () => escolhidos().reduce((s,i)=>s+i.preco*i.quantidade,0);
  const desconto = () => cupom ? subtotal() * (cupom.pct/100) : 0;
  const total = () => Math.max(0, subtotal() - desconto());
  const freteGratis = () => freteCfg !== null && total() >= freteCfg;

  function render(){
    const vazio = itens.length === 0;
    $('sc-cheio').style.display = vazio ? 'none' : '';
    $('sc-bar').style.display = vazio ? 'none' : '';
    $('sc-vazio').classList.toggle('on', vazio);
    if (vazio){ carregouReco(); totais(); medir(); return; }

    const l = visiveis();
    const lista = $('sc-lista');
    if (!l.length){
      lista.innerHTML = `<div class="sc-painel" style="padding:26px;text-align:center;animation:none;opacity:1;transform:none">
        <p style="margin:0;font-size:13.5px;color:var(--tinta2)">Nenhuma peça corresponde a “${busca}”.</p></div>`;
    } else {
      lista.innerHTML = l.map(i=>{
        const idx = itens.indexOf(i);
        const mx = maxDe(i);
        const sem = i.indisponivel || mx === 0;
        const pouco = !sem && mx > 0 && mx <= 2;
        const on = sel.has(String(i.id));
        return `<article class="sc-item ${sem?'fora':''}" data-id="${i.id}" data-idx="${idx}" draggable="true">
          <span class="sc-grip" data-grip aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg></span>
          <label class="sc-chk" style="padding:2px 0"><input type="checkbox" data-sel="${i.id}" ${on?'checked':''} ${sem?'disabled':''} aria-label="Selecionar ${i.nome}"><span class="sc-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg></span></label>
          <div class="sc-foto" data-abrir="${i.id}" role="button" tabindex="0" aria-label="Ver ${i.nome}">
            <img src="${i.imagens[0]}" alt="${i.nome}" onerror="this.src='${BASE}logo.png'">
            <span class="sc-foto-zoom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M21 21l-5-5m2-5a7 7 0 11-14 0 7 7 0 0114 0zM11 8v6M8 11h6"/></svg></span>
          </div>
          <div class="sc-corpo">
            ${i.colecao||i.categoria?`<span class="sc-eyebrow">${i.colecao||i.categoria}</span>`:''}
            <h3 class="sc-nome" data-abrir="${i.id}">${i.nome}</h3>
            <span class="sc-unit">${brl(i.preco)} por peça</span>
            <div class="sc-tags">
              ${sem?`<span class="sc-tag terra">Indisponível</span>`:''}
              ${pouco?`<span class="sc-tag ambar">Últimas ${mx}</span>`:''}
              ${i.numeracao?`<span class="sc-tag lapis">Nº ${i.numeracao}</span>`:''}
              ${i.imagens.length>1?`<span class="sc-tag ouro">${i.imagens.length} fotos</span>`:''}
            </div>
            <div class="sc-rodape">
              <div class="sc-qtd">
                <button type="button" data-q="menos" data-id="${i.id}" ${i.quantidade<=1||sem?'disabled':''} aria-label="Diminuir">−</button>
                <input type="number" min="1" max="${mx||99}" value="${i.quantidade}" data-qin="${i.id}" ${sem?'disabled':''} aria-label="Quantidade de ${i.nome}">
                <button type="button" data-q="mais" data-id="${i.id}" ${sem||i.quantidade>=mx?'disabled':''} aria-label="Aumentar">+</button>
              </div>
              <strong class="sc-linha-total">${brl(i.preco*i.quantidade)}</strong>
            </div>
            <div class="sc-acoes">
              <button type="button" class="sc-link info" data-abrir="${i.id}">Ver detalhes</button>
              <button type="button" class="sc-link" data-salvar="${i.id}">Guardar para depois</button>
              <button type="button" class="sc-link perigo" data-remover="${i.id}">Remover</button>
            </div>
          </div>
        </article>`;
      }).join('');
    }

    const sv = $('sc-secao-salvos');
    if (salvos.length){
      sv.style.display = '';
      $('sc-salvos-n').textContent = salvos.length === 1 ? '1 peça' : `${salvos.length} peças`;
      $('sc-salvos').innerHTML = salvos.map(i=>`<div class="sc-salvo">
        <img src="${i.imagem||BASE+'logo.png'}" alt="${i.nome}" onerror="this.src='${BASE}logo.png'">
        <div class="sc-salvo-c">
          <p class="sc-salvo-n">${i.nome}</p>
          <div class="sc-salvo-p">${brl(i.preco)}</div>
          <div class="sc-salvo-a">
            <button type="button" class="voltar" data-voltar="${i.id}">Voltar à sacola</button>
            <button type="button" class="lixo" data-lixo="${i.id}" aria-label="Descartar">×</button>
          </div>
        </div></div>`).join('');
      requestAnimationFrame(()=>sv.classList.add('vis'));
    } else { sv.style.display = 'none'; sv.classList.remove('vis'); }

    const n = escolhidos().length;
    $('sc-lote').classList.toggle('on', n > 0 && n < itens.length);
    $('sc-lote-n').textContent = n === 1 ? '1 peça selecionada' : `${n} peças selecionadas`;
    $('sc-todos').checked = itens.length > 0 && n === itens.length;
    $('sc-hero-txt').textContent = `${itens.reduce((s,i)=>s+i.quantidade,0)} peça(s) na sacola · ${n} selecionada(s) para o pedido.`;
    $('sc-arraste-nota').style.display = ordem === 'manual' ? '' : 'none';
    totais(); medir();
  }

  function totais(){
    const s = subtotal(), d = desconto(), t = total();
    $('sc-sub').textContent = brl(s);
    $('sc-sub-label').textContent = `Subtotal · ${escolhidos().reduce((a,i)=>a+i.quantidade,0)} peça(s)`;
    $('sc-desc-l').style.display = d > 0 ? '' : 'none';
    $('sc-desc').textContent = '− ' + brl(d);
    if (cupom){ $('sc-desc-label').textContent = `Cupom ${cupom.codigo} (−${cupom.pct}%)`; $('sc-cupom-ativo').classList.add('on'); $('sc-cupom-label').textContent = `${cupom.codigo} · −${cupom.pct}%`; $('sc-cupom-form').style.display='none'; }
    else { $('sc-cupom-ativo').classList.remove('on'); $('sc-cupom-form').style.display=''; }
    $('sc-total').textContent = brl(t);
    $('sc-total-m').textContent = brl(t);
    const fv = $('sc-frete-valor');
    if (freteGratis()){ fv.textContent = 'grátis'; fv.style.color = 'var(--verdigris)'; }
    else { fv.textContent = 'a combinar'; fv.style.color = 'var(--lapis)'; }
    if (freteCfg !== null){
      $('sc-frete-bar-wrap').style.display = '';
      $('sc-frete-bar').style.width = Math.min(100, (t/freteCfg)*100) + '%';
      $('sc-frete-titulo').textContent = freteGratis() ? 'Frete grátis conquistado' : `Faltam ${brl(freteCfg-t)} para frete grátis`;
    }
    if (cepInfo && cepInfo.cidade){
      $('sc-frete-nota').innerHTML = `Entrega em <b>${cepInfo.cidade}/${cepInfo.uf}</b>${freteGratis()?' · frete grátis':' · valor combinado no WhatsApp'}.`;
    }
    const bloqueado = escolhidos().length === 0;
    ['sc-finalizar','sc-finalizar-m'].forEach(id=>{ const b=$(id); if(b) b.disabled = bloqueado; });
  }

  function medir(){
    const b = $('sc-bar');
    const h = b && getComputedStyle(b).display !== 'none' ? b.offsetHeight : 0;
    document.documentElement.style.setProperty('--buy-h', h+'px');
  }

  function toast(txt, acao, fn, tipo){
    const t = $('sc-toast'), b = $('sc-toast-acao');
    $('sc-toast-txt').textContent = txt;
    t.classList.remove('err','ok'); if (tipo) t.classList.add(tipo);
    if (acao){ b.style.display=''; b.textContent=acao; b.onclick=fn; } else b.style.display='none';
    t.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(()=>t.classList.remove('on'), 5200);
  }

  function remover(ids, msg){
    const backup = ids.map(id=>({ item:itens.find(i=>String(i.id)===String(id)), pos:itens.findIndex(i=>String(i.id)===String(id)) })).filter(b=>b.item);
    if (!backup.length) return;
    ids.forEach(id=>{ const k = itens.findIndex(i=>String(i.id)===String(id)); if(k>-1) itens.splice(k,1); sel.delete(String(id)); });
    persistir(); render();
    toast(msg || (backup.length===1?'Peça removida da sacola.':`${backup.length} peças removidas.`), 'Desfazer', ()=>{
      backup.sort((a,b)=>a.pos-b.pos).forEach(b=>{ itens.splice(Math.min(b.pos,itens.length),0,b.item); sel.add(String(b.item.id)); });
      persistir(); render(); toast('Remoção desfeita.', null, null, 'ok');
    });
  }
  function guardar(ids){
    const movidos = [];
    ids.forEach(id=>{
      const k = itens.findIndex(i=>String(i.id)===String(id));
      if (k<0) return;
      const i = itens[k];
      if (!salvos.some(s=>String(s.id)===String(i.id))) salvos.unshift(minimo(i));
      movidos.push({ item:i, pos:k }); itens.splice(k,1); sel.delete(String(id));
    });
    if (!movidos.length) return;
    persistir(); render();
    toast(movidos.length===1?'Peça guardada para depois.':`${movidos.length} peças guardadas.`, 'Desfazer', ()=>{
      movidos.sort((a,b)=>a.pos-b.pos).forEach(m=>{
        itens.splice(Math.min(m.pos,itens.length),0,m.item); sel.add(String(m.item.id));
        const k = salvos.findIndex(s=>String(s.id)===String(m.item.id)); if(k>-1) salvos.splice(k,1);
      });
      persistir(); render(); toast('De volta à sacola.', null, null, 'ok');
    });
  }
  function voltar(id){
    const k = salvos.findIndex(s=>String(s.id)===String(id)); if(k<0) return;
    const i = salvos[k]; salvos.splice(k,1);
    const ex = itens.find(x=>String(x.id)===String(i.id));
    if (ex) ex.quantidade += 1; else itens.push({ ...i, imagens:imgsDe(i.imagem,`${BASE}logo.png`), estoque:null });
    sel.add(String(i.id)); persistir(); render(); hidratar();
    toast('Peça de volta à sacola.', null, null, 'ok');
  }
  function mudarQtd(id, delta, absoluto){
    const i = itens.find(x=>String(x.id)===String(id)); if(!i) return;
    const mx = maxDe(i);
    let q = absoluto !== undefined ? absoluto : i.quantidade + delta;
    q = Math.max(1, Math.min(mx || 99, parseInt(q)||1));
    if (q === i.quantidade) return;
    i.quantidade = q; persistir(); render();
    if (absoluto === undefined && mx && q === mx) toast(`Limite de ${mx} peça(s) disponíveis desta joia.`, null, null, 'err');
  }

  function abrirGaveta(id){
    const i = itens.find(x=>String(x.id)===String(id)) || salvos.find(x=>String(x.id)===String(id));
    if (!i) return;
    gavetaId = String(id);
    const imgs = i.imagens && i.imagens.length ? i.imagens : imgsDe(i.imagem, `${BASE}logo.png`);
    const nums = String(i.numeracao||'').split(/[,;]/).map(s=>s.trim()).filter(Boolean);
    $('sc-gaveta-corpo').innerHTML = `
      <img class="sc-gaveta-foto" id="sc-gaveta-foto" src="${imgs[0]}" alt="${i.nome}" onerror="this.src='${BASE}logo.png'">
      ${imgs.length>1?`<div class="sc-gaveta-th">${imgs.map((u,k)=>`<button type="button" class="${k===0?'on':''}" data-gth="${k}"><img src="${u}" alt="Foto ${k+1}"></button>`).join('')}</div>`:''}
      ${i.colecao||i.categoria?`<span class="sc-eyebrow">${i.colecao||i.categoria}</span>`:''}
      <h3>${i.nome}</h3>
      <div class="sc-gaveta-preco">${brl(i.preco)}</div>
      ${nums.length?`<div class="sc-tags" style="margin-bottom:13px">${nums.map(n=>`<span class="sc-tag lapis">Nº ${n}</span>`).join('')}</div>`:''}
      <div class="sc-gaveta-desc">${i.descricao || '<p>Joia artesanal exclusiva Vivi Corrêa. Cada peça é única e feita à mão com carinho.</p>'}</div>
      <div style="margin-top:16px"><a href="${BASE}produto/${slug(i.nome)}" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--bronze);text-decoration:underline;text-underline-offset:3px">Abrir página da peça</a></div>`;
    $('sc-gaveta-corpo').querySelectorAll('[data-gth]').forEach(b=>b.addEventListener('click',()=>{
      $('sc-gaveta-corpo').querySelectorAll('[data-gth]').forEach(x=>x.classList.remove('on'));
      b.classList.add('on'); $('sc-gaveta-foto').src = imgs[+b.dataset.gth];
    }));
    const naSacola = itens.some(x=>String(x.id)===String(id));
    $('sc-gaveta-add').textContent = naSacola ? 'Adicionar mais uma' : 'Trazer para a sacola';
    $('sc-gaveta-salvar').style.display = naSacola ? '' : 'none';
    $('sc-gaveta-scrim').hidden = false;
    requestAnimationFrame(()=>$('sc-gaveta-scrim').classList.add('on'));
    $('sc-gaveta').classList.add('on'); $('sc-gaveta').setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function fecharGaveta(){
    $('sc-gaveta').classList.remove('on'); $('sc-gaveta').setAttribute('aria-hidden','true');
    $('sc-gaveta-scrim').classList.remove('on'); document.body.style.overflow = '';
    setTimeout(()=>{ $('sc-gaveta-scrim').hidden = true; }, 340); gavetaId = null;
  }

  let recoCarregado = false;
  async function carregouReco(){
    if (recoCarregado) return; recoCarregado = true;
    const alvo = $('sc-reco');
    alvo.innerHTML = Array.from({length:4}).map(()=>`<div class="sc-sk" style="grid-template-columns:1fr"><i class="a" style="aspect-ratio:1;height:auto"></i><div><i class="b"></i><i class="c"></i></div></div>`).join('');
    try{
      const { data } = await supabase.from('produtos').select('*').eq('destaque', true).limit(8);
      const lista = (data||[]).filter(p=>p && p.nome);
      if (!lista.length){ alvo.innerHTML = `<p style="grid-column:1/-1;font-size:12.5px;color:var(--tinta2)">Explore as coleções para escolher sua primeira peça.</p>`; return; }
      alvo.innerHTML = lista.map(p=>{
        const imgs = imgsDe(p.imagem_url, `${BASE}logo.png`);
        const pr = (p.preco_centavos||0)/100;
        return `<div class="sc-reco-c">
          <img src="${imgs[0]}" alt="${p.nome}" loading="lazy" onerror="this.src='${BASE}logo.png'">
          <div class="sc-reco-b"><p class="sc-reco-n">${p.nome}</p><span class="sc-reco-p">${brl(pr)}</span>
          <button type="button" data-reco="${p.id}" data-nome="${p.nome}" data-preco="${pr}" data-img="${imgs[0]}">Adicionar</button></div></div>`;
      }).join('');
      alvo.querySelectorAll('[data-reco]').forEach(b=>b.addEventListener('click',()=>{
        const id = b.dataset.reco;
        const ex = itens.find(i=>String(i.id)===String(id));
        if (ex) ex.quantidade += 1;
        else itens.push({ id, nome:b.dataset.nome, preco:parseFloat(b.dataset.preco)||0, imagem:b.dataset.img, quantidade:1, imagens:[b.dataset.img], estoque:null });
        sel.add(String(id)); persistir(); render(); hidratar();
        toast('Peça adicionada à sacola.', null, null, 'ok');
      }));
    }catch(e){ alvo.innerHTML = `<p style="grid-column:1/-1;font-size:12.5px;color:var(--tinta2)">Explore as coleções para escolher sua primeira peça.</p>`; }
  }

  async function aplicarCupom(){
    const cod = $('sc-cupom').value.trim().toUpperCase();
    const msg = $('sc-cupom-msg');
    if (!cod){ msg.className='sc-cupom-msg on err'; msg.textContent='Digite o código do cupom.'; return; }
    msg.className='sc-cupom-msg on'; msg.style.color='var(--lapis)'; msg.textContent='Verificando cupom…';
    let pct = null;
    if (cupomCfg && String(cupomCfg.codigo).toUpperCase() === cod) pct = parseFloat(cupomCfg.pct)||10;
    if (pct === null){
      try{
        const { data } = await supabase.from('newsletter').select('cupom_utilizado').ilike('cupom_utilizado', cod).limit(1);
        if (data && data.length) pct = 10;
      }catch(e){}
    }
    if (pct === null){ msg.className='sc-cupom-msg on err'; msg.textContent='Cupom não encontrado. Use o código que recebeu ao assinar a newsletter.'; return; }
    cupom = { codigo:cod, pct }; persistir(); $('sc-cupom').value=''; msg.className='sc-cupom-msg'; msg.textContent='';
    render(); toast(`Cupom ${cod} aplicado: −${pct}%.`, null, null, 'ok');
  }

  async function calcularCep(){
    const cep = soD($('sc-cep').value);
    const nota = $('sc-frete-nota');
    if (cep.length !== 8){ nota.innerHTML = 'Digite os 8 dígitos do CEP.'; return; }
    nota.innerHTML = 'Consultando CEP…';
    const ctrl = new AbortController(); const t = setTimeout(()=>ctrl.abort(), 6000);
    try{
      const r = await fetch(`https://viacep.com.br/ws/${cep}/json/`, { signal:ctrl.signal });
      const d = await r.json();
      if (d.erro){ nota.innerHTML = 'CEP não encontrado. Confira os números.'; cepInfo = null; }
      else { cepInfo = { cep, cidade:d.localidade||'', uf:d.uf||'' }; persistir(); toast(`Entrega em ${cepInfo.cidade}/${cepInfo.uf}.`, null, null, 'ok'); }
    }catch(e){ nota.innerHTML = 'Não foi possível consultar o CEP agora. O envio será combinado no WhatsApp.'; }
    finally{ clearTimeout(t); totais(); }
  }

  function finalizar(){
    const l = escolhidos();
    if (!l.length){ toast('Selecione ao menos uma peça para finalizar.', null, null, 'err'); return; }
    gravar(K.sel, l.map(i=>String(i.id)));
    window.location.href = `${BASE}checkout`;
  }

  $('sc-lista').addEventListener('click', e=>{
    const q = e.target.closest('[data-q]');
    if (q){ mudarQtd(q.dataset.id, q.dataset.q==='mais'?1:-1); return; }
    const r = e.target.closest('[data-remover]'); if (r){ remover([r.dataset.remover]); return; }
    const s = e.target.closest('[data-salvar]'); if (s){ guardar([s.dataset.salvar]); return; }
    const a = e.target.closest('[data-abrir]'); if (a){ abrirGaveta(a.dataset.abrir); return; }
  });
  $('sc-lista').addEventListener('change', e=>{
    const c = e.target.closest('[data-sel]');
    if (c){ const id = String(c.dataset.sel); if (c.checked) sel.add(id); else sel.delete(id); persistir(); render(); return; }
    const n = e.target.closest('[data-qin]');
    if (n) mudarQtd(n.dataset.qin, 0, n.value);
  });
  $('sc-lista').addEventListener('keydown', e=>{
    const a = e.target.closest('[data-abrir]');
    if (a && (e.key==='Enter'||e.key===' ')){ e.preventDefault(); abrirGaveta(a.dataset.abrir); }
  });
  $('sc-lista').addEventListener('dragstart', e=>{
    const it = e.target.closest('.sc-item'); if (!it || ordem!=='manual'){ e.preventDefault(); return; }
    arrasteIdx = +it.dataset.idx; it.classList.add('arrastando');
    try { e.dataTransfer.effectAllowed='move'; e.dataTransfer.setData('text/plain', String(arrasteIdx)); } catch(err){}
  });
  $('sc-lista').addEventListener('dragover', e=>{
    if (arrasteIdx===null) return; e.preventDefault();
    const it = e.target.closest('.sc-item'); if (!it) return;
    $('sc-lista').querySelectorAll('.sc-item').forEach(x=>x.classList.remove('alvo'));
    if (+it.dataset.idx !== arrasteIdx) it.classList.add('alvo');
  });
  $('sc-lista').addEventListener('drop', e=>{
    if (arrasteIdx===null) return; e.preventDefault();
    const it = e.target.closest('.sc-item');
    if (it){ const alvo = +it.dataset.idx; if (alvo !== arrasteIdx){ const [m] = itens.splice(arrasteIdx,1); itens.splice(alvo,0,m); persistir(); render(); toast('Ordem das peças atualizada.', null, null, 'ok'); } }
    arrasteIdx = null;
  });
  $('sc-lista').addEventListener('dragend', ()=>{ arrasteIdx=null; $('sc-lista').querySelectorAll('.sc-item').forEach(x=>x.classList.remove('arrastando','alvo')); });

  $('sc-salvos').addEventListener('click', e=>{
    const v = e.target.closest('[data-voltar]'); if (v){ voltar(v.dataset.voltar); return; }
    const l = e.target.closest('[data-lixo]');
    if (l){ const id=l.dataset.lixo; const k=salvos.findIndex(s=>String(s.id)===String(id)); if(k<0) return;
      const bkp={item:salvos[k],pos:k}; salvos.splice(k,1); persistir(); render();
      toast('Peça descartada dos guardados.', 'Desfazer', ()=>{ salvos.splice(Math.min(bkp.pos,salvos.length),0,bkp.item); persistir(); render(); });
    }
  });
  $('sc-todos').addEventListener('change', e=>{ sel = e.target.checked ? new Set(itens.map(i=>String(i.id))) : new Set(); persistir(); render(); });
  $('sc-busca').addEventListener('input', e=>{ busca = e.target.value; render(); });
  $('sc-ordem').addEventListener('change', e=>{ ordem = e.target.value; persistir(); render(); });
  $('sc-lote-remover').addEventListener('click', ()=>remover(Array.from(sel)));
  $('sc-lote-salvar').addEventListener('click', ()=>guardar(Array.from(sel)));
  $('sc-lote-limpar').addEventListener('click', ()=>{ sel=new Set(); persistir(); render(); });
  $('sc-cupom-btn').addEventListener('click', aplicarCupom);
  $('sc-cupom').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); aplicarCupom(); } });
  $('sc-cupom-x').addEventListener('click', ()=>{ cupom=null; persistir(); render(); toast('Cupom removido.'); });
  $('sc-cep-btn').addEventListener('click', calcularCep);
  $('sc-cep').addEventListener('input', e=>{ e.target.value = mCEP(e.target.value); });
  $('sc-cep').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); calcularCep(); } });
  $('sc-finalizar').addEventListener('click', finalizar);
  $('sc-finalizar-m').addEventListener('click', finalizar);
  $('sc-gaveta-x').addEventListener('click', fecharGaveta);
  $('sc-gaveta-scrim').addEventListener('click', fecharGaveta);
  $('sc-gaveta-add').addEventListener('click', ()=>{
    if (!gavetaId) return;
    if (!itens.some(i=>String(i.id)===gavetaId)) voltar(gavetaId);
    else mudarQtd(gavetaId, 1);
    toast('Peça adicionada à sacola.', null, null, 'ok'); fecharGaveta();
  });
  $('sc-gaveta-salvar').addEventListener('click', ()=>{ if(gavetaId){ guardar([gavetaId]); fecharGaveta(); } });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') fecharGaveta(); });
  window.addEventListener('resize', medir);
  window.addEventListener('orientationchange', ()=>setTimeout(medir,260));
  window.addEventListener('load', medir);
  window.addEventListener('storage', e=>{ if (e.key===K.cart){ carregar(); render(); } });
  if (window.ResizeObserver) new ResizeObserver(medir).observe($('sc-bar'));
  if (window.IntersectionObserver){
    const io = new IntersectionObserver(es=>es.forEach(x=>{ if(x.isIntersecting){ x.target.classList.add('vis'); io.unobserve(x.target); } }), { threshold:.12 });
    document.querySelectorAll('.sc-secao').forEach(s=>io.observe(s));
  } else document.querySelectorAll('.sc-secao').forEach(s=>s.classList.add('vis'));

  carregar(); render(); medir(); hidratar(); configuracoes();
</script>
</body>
</html>
