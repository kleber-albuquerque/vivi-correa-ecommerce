  .sc-foot p{margin:2px 0}
  @keyframes scSobe{to{opacity:1;transform:none}}

  @media (max-width:899px){ .sc{padding-bottom:calc(var(--nav-h) + var(--buy-h) + 16px)} .sc-bar{display:block} .sc-painel .sc-btn.principal{display:none} }
  @media (min-width:560px){ .sc-item{grid-template-columns:auto 104px minmax(0,1fr);gap:15px;padding:15px} .sc-foto{width:104px;height:126px} .sc-nome{font-size:22px} }
  @media (min-width:900px){
    .sc-wrap{padding:36px 24px 84px}
