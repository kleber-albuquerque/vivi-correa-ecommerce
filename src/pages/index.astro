<script id="hm-seed" type="application/json" set:html={seedJSON}></script>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
  const $ = id => document.getElementById(id);
  const BASE = import.meta.env.BASE_URL;
  const brl = v => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(v||0);
  const slug = s => String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'');
  const esc = s => String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fotos = b => { let a=[]; if(typeof b==='string'&&b.trim()){ try{const j=JSON.parse(b); a=Array.isArray(j)?j.filter(Boolean):[b];}catch(e){a=[b];} } else if(Array.isArray(b)) a=b.filter(Boolean); return a.length?a:[BASE+'logo.png']; };
  const semMovimento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  let seed = { produtos:[], banners:[] };
  try { seed = JSON.parse($('hm-seed').textContent || '{}'); } catch(e){}
  let produtos = Array.isArray(seed.produtos) ? seed.produtos : [];
  let toastT = null, cupomAtual = null;

  const lerCart = () => { try { const v = JSON.parse(localStorage.getItem('carrinho_vivi')); return Array.isArray(v)?v:[]; } catch(e){ return []; } };
  function toast(t, s, err){
    $('hm-toast-t').textContent = t; $('hm-toast-s').textContent = s || '';
    $('hm-toast').classList.toggle('err', !!err); $('hm-toast').classList.add('on');
    clearTimeout(toastT); toastT = setTimeout(()=>$('hm-toast').classList.remove('on'), 4200);
  }
  function addSacola(p){
    const c = lerCart();
    const ex = c.find(i=>String(i.id)===String(p.id));
    if (ex) ex.quantidade = (parseInt(ex.quantidade)||0)+1;
    else c.push({ id:p.id, nome:p.nome, preco:p.preco, imagem:p.img, quantidade:1 });
    try { localStorage.setItem('carrinho_vivi', JSON.stringify(c)); } catch(e){}
    let sel = []; try { const v = JSON.parse(localStorage.getItem('selecao_vivi')); sel = Array.isArray(v)?v:[]; } catch(e){}
    if (sel.length && !sel.map(String).includes(String(p.id))){ sel.push(String(p.id)); try{ localStorage.setItem('selecao_vivi', JSON.stringify(sel)); }catch(e){} }
    window.dispatchEvent(new CustomEvent('carrinho-atualizado'));
    toast('Peça na sua sacola', p.nome);
  }
  document.addEventListener('click', e=>{
    const b = e.target.closest('[data-add]');
    if (!b || b.disabled) return;
    e.preventDefault(); e.stopPropagation();
    addSacola({ id:b.dataset.add, nome:b.dataset.nome, preco:parseFloat(b.dataset.preco)||0, img:b.dataset.img });
    b.animate?.([{transform:'scale(1)'},{transform:'scale(1.28)'},{transform:'scale(1)'}], {duration:340, easing:'cubic-bezier(.34,1.56,.64,1)'});
  });

  const slides = Array.from(document.querySelectorAll('.hm-slide'));
  const dots = Array.from(document.querySelectorAll('[data-dot]'));
  const heroProg = $('hm-hero-prog');
  const DUR = 6200;
  let bi = 0, acc = 0, ultimo = 0, pausado = false, heroVisivel = true, rafHero = null;
  function irBanner(i, resetar){
    if (!slides.length) return;
    bi = (i + slides.length) % slides.length;
    slides.forEach((el,k)=>el.classList.toggle('on', k===bi));
    dots.forEach((d,k)=>d.classList.toggle('on', k===bi));
    if (resetar !== false) acc = 0;
  }
  function loopHero(t){
    if (!ultimo) ultimo = t;
    const dt = Math.min(120, t - ultimo); ultimo = t;
    if (slides.length > 1 && !pausado && heroVisivel && !document.hidden && !semMovimento()){
      acc += dt;
      if (acc >= DUR){ acc = 0; irBanner(bi+1, false); }
    }
    if (heroProg) heroProg.style.width = (slides.length>1 ? Math.min(100,(acc/DUR)*100) : 0) + '%';
    rafHero = requestAnimationFrame(loopHero);
  }
  if (slides.length > 1 && !rafHero) rafHero = requestAnimationFrame(loopHero);
  const nx = $('hm-next'), pv = $('hm-prev');
  if (nx) nx.addEventListener('click', ()=>irBanner(bi+1));
  if (pv) pv.addEventListener('click', ()=>irBanner(bi-1));
  dots.forEach(d=>d.addEventListener('click', ()=>irBanner(+d.dataset.dot)));
  const hero = $('hm-hero');
  hero.addEventListener('mouseenter', ()=>{ pausado = true; });
  hero.addEventListener('mouseleave', ()=>{ pausado = false; });
  hero.addEventListener('focusin', ()=>{ pausado = true; });
  hero.addEventListener('focusout', ()=>{ pausado = false; });
  let hx0 = null, hy0 = null;
  hero.addEventListener('touchstart', e=>{ hx0 = e.touches[0].clientX; hy0 = e.touches[0].clientY; pausado = true; }, {passive:true});
  hero.addEventListener('touchend', e=>{
    if (hx0 !== null){
      const dx = e.changedTouches[0].clientX - hx0, dy = e.changedTouches[0].clientY - hy0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) irBanner(bi + (dx<0?1:-1));
    }
    hx0 = hy0 = null; pausado = false;
  }, {passive:true});
  if (window.IntersectionObserver){
    new IntersectionObserver(es=>es.forEach(x=>{ heroVisivel = x.isIntersecting; }), {threshold:.12}).observe(hero);
  }

  function estadoSetas(id){
    const r = $('rail-'+id); if(!r) return;
    const p = document.querySelector(`[data-rail-prev="${id}"]`), n = document.querySelector(`[data-rail-next="${id}"]`);
    if (p) p.disabled = r.scrollLeft <= 4;
    if (n) n.disabled = r.scrollLeft + r.clientWidth >= r.scrollWidth - 4;
  }
  function passo(id, dir){
    const r = $('rail-'+id); if(!r) return;
    const card = r.querySelector('.hm-card, .hm-col');
    const w = card ? card.getBoundingClientRect().width + 12 : 240;
    r.scrollBy({ left: dir * Math.max(w, r.clientWidth*0.7), behavior:'smooth' });
  }
  document.querySelectorAll('[data-rail-next]').forEach(b=>b.addEventListener('click', ()=>passo(b.dataset.railNext, 1)));
  document.querySelectorAll('[data-rail-prev]').forEach(b=>b.addEventListener('click', ()=>passo(b.dataset.railPrev, -1)));
  document.querySelectorAll('[data-rail]').forEach(r=>{
    const id = r.dataset.rail;
    estadoSetas(id);
    r.addEventListener('scroll', ()=>estadoSetas(id), {passive:true});
    let down=false, sx=0, sl=0, moveu=false;
    r.addEventListener('pointerdown', e=>{ if(e.pointerType!=='mouse'||e.target.closest('[data-add]')) return; down=true; moveu=false; sx=e.clientX; sl=r.scrollLeft; r.classList.add('arrasta'); });
    r.addEventListener('pointermove', e=>{ if(!down) return; const dx=e.clientX-sx; if(Math.abs(dx)>4) moveu=true; r.scrollLeft = sl-dx; });
    const solta = ()=>{ down=false; r.classList.remove('arrasta'); };
    r.addEventListener('pointerup', solta); r.addEventListener('pointerleave', solta); r.addEventListener('pointercancel', solta);
    r.addEventListener('click', e=>{ if(moveu){ e.preventDefault(); e.stopPropagation(); moveu=false; } }, true);
  });
  window.addEventListener('resize', ()=>document.querySelectorAll('[data-rail]').forEach(r=>estadoSetas(r.dataset.rail)));

  if (window.IntersectionObserver){
    const io = new IntersectionObserver(es=>es.forEach(x=>{ if(x.isIntersecting){ x.target.classList.add('vis'); io.unobserve(x.target); } }), {threshold:.08});
    document.querySelectorAll('.hm-sec').forEach(s=>io.observe(s));
    const ioH = new IntersectionObserver(es=>es.forEach(x=>{
      if (x.isIntersecting && x.intersectionRatio > .28){
        if (x.target.dataset.hue) document.body.style.setProperty('--hue', x.target.dataset.hue);
        if (x.target.dataset.hue2) document.body.style.setProperty('--hue2', x.target.dataset.hue2);
      }
    }), {threshold:[.3,.6]});
    document.querySelectorAll('[data-hue]').forEach(s=>ioH.observe(s));
  } else document.querySelectorAll('.hm-sec').forEach(s=>s.classList.add('vis'));

  let rafP = null;
  function aoRolar(){
    if (rafP) return;
    rafP = requestAnimationFrame(()=>{
      rafP = null;
      const h = document.documentElement.scrollHeight - window.innerHeight;
      const prog = $('hm-prog'); if (prog) prog.style.width = (h>0 ? (window.scrollY/h)*100 : 0) + '%';
      if (window.innerWidth >= 900 && !semMovimento()){
        document.querySelectorAll('[data-par]').forEach(f=>{
          const r = f.getBoundingClientRect();
          if (r.bottom < -200 || r.top > window.innerHeight + 200) return;
          const c = (r.top + r.height/2 - window.innerHeight/2) / window.innerHeight;
          f.style.transform = `translateY(${(-c * (14 + (+f.dataset.par)*7)).toFixed(1)}px)`;
        });
      }
    });
  }
  window.addEventListener('scroll', aoRolar, {passive:true});
  window.addEventListener('resize', aoRolar);
  aoRolar();

  let buscaSel = -1, buscaLista = [];
  function abrirBusca(){
    $('hm-busca-scrim').hidden = false;
    requestAnimationFrame(()=>$('hm-busca-scrim').classList.add('on'));
    $('hm-busca').classList.add('on'); document.body.style.overflow='hidden';
    setTimeout(()=>$('hm-busca-in').focus(), 120);
    if (!$('hm-busca-in').value) renderBusca('');
  }
  function fecharBusca(){
    $('hm-busca').classList.remove('on'); $('hm-busca-scrim').classList.remove('on');
    document.body.style.overflow=''; setTimeout(()=>{ $('hm-busca-scrim').hidden = true; }, 320);
  }
  function renderBusca(q){
    const termo = q.trim().toLowerCase();
    buscaLista = !termo ? produtos.filter(p=>p.destaque).slice(0,8)
      : produtos.filter(p=>(p.nome+' '+(p.colecao||'')+' '+(p.categoria||'')).toLowerCase().includes(termo)).slice(0,24);
    if (!buscaLista.length && !termo) buscaLista = produtos.slice(0,8);
    buscaSel = -1;
    const alvo = $('hm-busca-res');
    if (!buscaLista.length){
      alvo.innerHTML = `<div class="hm-busca-vazio">${termo?`Nada encontrado para “${esc(q)}”.<br>Tente o nome da peça ou da coleção.`:'As peças estão sendo cadastradas no ateliê.'}</div>`;
      return;
    }
    alvo.innerHTML = (termo?'':'<div class="hm-busca-vazio" style="padding:10px 12px;text-align:left;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--tinta3)">Destaques do ateliê</div>') +
      buscaLista.map((p,i)=>{
        const f = fotos(p.imagem_url)[0], pr = (p.preco_centavos||0)/100;
        return `<a class="hm-busca-item" href="${BASE}produto/${slug(p.nome)}" data-bi="${i}">
          <img src="${f}" alt="" onerror="this.src='${BASE}logo.png'">
          <div class="t"><b>${esc(p.nome)}</b><span>${esc(p.colecao||p.categoria||'Joia autoral')}</span></div>
          <span class="p">${brl(pr)}</span></a>`;
      }).join('');
  }
  $('hm-abre-busca').addEventListener('click', abrirBusca);
  $('hm-busca-x').addEventListener('click', fecharBusca);
  $('hm-busca-scrim').addEventListener('click', fecharBusca);
  $('hm-busca-in').addEventListener('input', e=>renderBusca(e.target.value));
  $('hm-busca-in').addEventListener('keydown', e=>{
    const itens = Array.from(document.querySelectorAll('.hm-busca-item'));
    if (e.key==='ArrowDown'||e.key==='ArrowUp'){
      e.preventDefault(); if(!itens.length) return;
      buscaSel = (buscaSel + (e.key==='ArrowDown'?1:-1) + itens.length) % itens.length;
      itens.forEach((el,k)=>el.classList.toggle('sel', k===buscaSel));
      itens[buscaSel].scrollIntoView({block:'nearest'});
    }
    if (e.key==='Enter'){ e.preventDefault(); const el = itens[buscaSel] || itens[0]; if(el) window.location.href = el.getAttribute('href'); }
  });
  document.addEventListener('keydown', e=>{
    const digitando = /input|textarea|select/i.test(document.activeElement?.tagName||'');
    const modal = $('hm-busca').classList.contains('on') || $('hm-exit').classList.contains('on');
    if (e.key==='/' && !digitando && !modal){ e.preventDefault(); abrirBusca(); }
    if (e.key==='Escape'){ fecharBusca(); fecharExit(); }
    if (!digitando && !modal && slides.length>1 && heroVisivel){
      if (e.key==='ArrowRight') irBanner(bi+1);
      if (e.key==='ArrowLeft') irBanner(bi-1);
    }
  });

  const emailOk = v => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());
  const novoCupom = () => 'VIVI10-' + Array.from({length:4},()=> 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.floor(Math.random()*32)]).join('');
  function guardarCupom(cod){
    cupomAtual = cod;
    try { localStorage.setItem('cupom_vivi', JSON.stringify({ codigo:cod, pct:10 })); localStorage.setItem('newsletter_ok','1'); } catch(e){}
  }
  async function assinar(nome, email){
    const n = nome.trim(), e = email.trim().toLowerCase();
    if (n.length < 2) return { erro:'Digite seu nome.' };
    if (!emailOk(e)) return { erro:'Digite um e-mail válido.' };
    try{
      const { data: ja } = await supabase.from('newsletter').select('cupom_utilizado').eq('email', e).limit(1);
      if (ja && ja.length){
        const cod = ja[0].cupom_utilizado || novoCupom();
        if (!ja[0].cupom_utilizado) await supabase.from('newsletter').update({ cupom_utilizado:cod }).eq('email', e);
        guardarCupom(cod); return { cod, existente:true };
      }
      const cod = novoCupom();
      const { error } = await supabase.from('newsletter').insert([{ nome:n, email:e, cupom_utilizado:cod }]);
      if (error){
        const { data: again } = await supabase.from('newsletter').select('cupom_utilizado').eq('email', e).limit(1);
        const c2 = again?.[0]?.cupom_utilizado || cod;
        guardarCupom(c2); return { cod:c2, existente:true };
      }
      guardarCupom(cod); return { cod };
    }catch(err){ return { erro:'Não foi possível conectar agora. Tente novamente em instantes.' }; }
  }
  async function copiar(txt, botao){
    try { await navigator.clipboard.writeText(txt); }
    catch(e){ const ta=document.createElement('textarea'); ta.value=txt; ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');}catch(_){} ta.remove(); }
    const velho = botao.textContent; botao.textContent = 'Copiado ✓';
    setTimeout(()=>botao.textContent = velho, 1900);
  }
  $('hm-news-form').addEventListener('submit', async e=>{
    e.preventDefault();
    const btn = $('hm-news-btn'), msg = $('hm-news-msg');
    const nome = $('hm-news-nome'), mail = $('hm-news-email');
    nome.classList.remove('ruim'); mail.classList.remove('ruim');
    if (nome.value.trim().length<2) nome.classList.add('ruim');
    if (!emailOk(mail.value)) mail.classList.add('ruim');
    if (nome.classList.contains('ruim')||mail.classList.contains('ruim')){ msg.className='hm-news-msg err'; msg.textContent='Confira seu nome e e-mail.'; return; }
    btn.disabled = true; btn.textContent = 'Gerando seu cupom…'; msg.className='hm-news-msg'; msg.textContent='';
    const r = await assinar(nome.value, mail.value);
    btn.disabled = false; btn.textContent = 'Quero meu cupom de 10%';
    if (r.erro){ msg.className='hm-news-msg err'; msg.textContent = r.erro; return; }
    $('hm-cupom-cod').textContent = r.cod;
    $('hm-cupom').classList.add('on');
    $('hm-news-form').style.display = 'none';
    toast('Cupom de 10% liberado', r.cod);
  });
  $('hm-cupom-copy').addEventListener('click', e=>copiar(cupomAtual || $('hm-cupom-cod').textContent, e.currentTarget));
  $('hm-cupom-aplicar').addEventListener('click', ()=>{ guardarCupom(cupomAtual || $('hm-cupom-cod').textContent); window.location.href = `${BASE}carrinho`; });

  let exitPronto = false, exitAberto = false;
  const jaAssinou = () => { try { return localStorage.getItem('newsletter_ok')==='1'; } catch(e){ return false; } };
  const vistoSessao = () => { try { return sessionStorage.getItem('exit_visto')==='1'; } catch(e){ return false; } };
  function abrirExit(){
    if (exitAberto || jaAssinou() || vistoSessao() || !exitPronto) return;
    if ($('hm-busca').classList.contains('on')) return;
    exitAberto = true;
    try { sessionStorage.setItem('exit_visto','1'); } catch(e){}
    $('hm-exit-scrim').hidden = false;
    requestAnimationFrame(()=>$('hm-exit-scrim').classList.add('on'));
    $('hm-exit').classList.add('on'); document.body.style.overflow='hidden';
    setTimeout(()=>$('hm-exit-email').focus(), 260);
  }
  function fecharExit(){
    if (!exitAberto) return;
    exitAberto = false;
    $('hm-exit').classList.remove('on'); $('hm-exit-scrim').classList.remove('on');
    document.body.style.overflow=''; setTimeout(()=>{ $('hm-exit-scrim').hidden = true; }, 340);
  }
  setTimeout(()=>{ exitPronto = true; }, 12000);
  document.addEventListener('mouseout', e=>{ if (!e.relatedTarget && e.clientY <= 4) abrirExit(); });
  $('hm-exit-x').addEventListener('click', fecharExit);
  $('hm-exit-nao').addEventListener('click', fecharExit);
  $('hm-exit-scrim').addEventListener('click', fecharExit);
  $('hm-exit-form').addEventListener('submit', async e=>{
    e.preventDefault();
    const btn = $('hm-exit-btn'), msg = $('hm-exit-msg');
    const nome = $('hm-exit-nome'), mail = $('hm-exit-email');
    nome.classList.remove('ruim'); mail.classList.remove('ruim');
    if (nome.value.trim().length<2) nome.classList.add('ruim');
    if (!emailOk(mail.value)) mail.classList.add('ruim');
    if (nome.classList.contains('ruim')||mail.classList.contains('ruim')){ msg.className='hm-exit-msg err'; msg.textContent='Confira seu nome e e-mail.'; return; }
    btn.disabled = true; btn.textContent = 'Liberando…'; msg.className='hm-exit-msg'; msg.textContent='';
    const r = await assinar(nome.value, mail.value);
    btn.disabled = false; btn.textContent = 'Liberar meu cupom';
    if (r.erro){ msg.className='hm-exit-msg err'; msg.textContent = r.erro; return; }
    $('hm-exit-cod').textContent = r.cod;
    $('hm-exit-form-wrap').style.display = 'none';
    $('hm-exit-cupom').classList.add('on');
    $('hm-cupom-cod').textContent = r.cod; $('hm-cupom').classList.add('on'); $('hm-news-form').style.display='none';
    toast('Cupom de 10% liberado', r.cod);
  });
  $('hm-exit-copy').addEventListener('click', e=>copiar(cupomAtual || $('hm-exit-cod').textContent, e.currentTarget));
  $('hm-exit-aplicar').addEventListener('click', ()=>{ guardarCupom(cupomAtual || $('hm-exit-cod').textContent); window.location.href = `${BASE}carrinho`; });

  function cardHTML(p){
    const fs = fotos(p.imagem_url), pr = (p.preco_centavos||0)/100;
    const est = (p.estoque===null||p.estoque===undefined) ? null : parseInt(p.estoque);
    const sem = est === 0;
    const selo = est===1 ? '<span class="hm-card-selo">Única</span>' : sem ? '<span class="hm-card-selo off">Esgotada</span>' : p.destaque ? '<span class="hm-card-selo ouro">Destaque</span>' : '';
    return `<a class="hm-card" href="${BASE}produto/${slug(p.nome)}">
      <div class="hm-card-f">${selo}
        <img class="pri" src="${fs[0]}" alt="${esc(p.nome)}" loading="lazy" onerror="this.src='${BASE}logo.png'">
        ${fs[1]?`<img class="alt" src="${fs[1]}" alt="" aria-hidden="true" loading="lazy">`:''}
        <button type="button" class="hm-add" data-add="${esc(p.id)}" data-nome="${esc(p.nome)}" data-preco="${pr}" data-img="${esc(fs[0])}" ${sem?'disabled':''} aria-label="Adicionar ${esc(p.nome)} à sacola">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg></button>
      </div>
      <div class="hm-card-c">
        ${p.colecao?`<span class="hm-card-col">${esc(p.colecao)}</span>`:''}
        <h3 class="hm-card-n">${esc(p.nome)}</h3>
        ${p.numeracao?`<span class="hm-card-nf">Nº ${esc(p.numeracao)}</span>`:''}
        <span class="hm-card-p">${brl(pr)}</span>
      </div></a>`;
  }
  async function revalidar(){
    try{
      const { data, error } = await supabase.from('produtos').select('id,nome,preco_centavos,imagem_url,categoria,colecao,destaque,estoque,numeracao').order('nome');
      if (error || !Array.isArray(data) || !data.length) return;
      const novos = data.filter(p=>p&&p.nome);
      if (JSON.stringify(novos) === JSON.stringify(produtos)) return;
      produtos = novos;
      const grupos = {
        destaques: novos.filter(p=>p.destaque),
        aneis: novos.filter(p=>String(p.categoria||'').toLowerCase().startsWith('an')),
        brincos: novos.filter(p=>String(p.categoria||'').toLowerCase().startsWith('brin')),
        colares: novos.filter(p=>String(p.categoria||'').toLowerCase().startsWith('col'))
      };
      Object.entries(grupos).forEach(([id, lista])=>{
        const r = $('rail-'+id); if(!r || !lista.length) return;
        r.innerHTML = lista.map(cardHTML).join('');
        estadoSetas(id);
      });
      if ($('hm-busca').classList.contains('on')) renderBusca($('hm-busca-in').value);
    }catch(e){}
  }
  setTimeout(revalidar, 1400);
  window.addEventListener('focus', ()=>setTimeout(revalidar, 400));
</script>
</body>
</html>
