---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY
);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Checkout - Vivi Correa</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style is:global>
        body { font-family: 'Montserrat', sans-serif; background-color: #faf9f7; }
        h1, h2, h3 { font-family: 'Cormorant Garamond', serif; }
        .text-brand { color: #8B7355; }
        .bg-brand { background-color: #8B7355; }
        .input-style { width: 100%; border: 1px solid #e5e7eb; padding: 0.75rem; border-radius: 0.25rem; background-color: #f9fafb; transition: all 0.2s; }
        .input-style:focus { outline: none; border-color: #8B7355; background-color: white; }
    </style>
</head>
<body class="text-gray-800 antialiased">
    
    <Header />

    <main class="container mx-auto px-6 py-16">
        <h1 class="text-3xl md:text-4xl text-center mb-12">Finalizar Pedido</h1>

        <div class="flex flex-col lg:flex-row gap-12 max-w-6xl mx-auto">
            
            <!-- Formulário -->
            <div class="lg:w-2/3 bg-white p-8 rounded-lg shadow-sm border border-gray-100">
                <form id="form-checkout" class="space-y-6">
                    <h2 class="text-2xl mb-4 border-b pb-2">1. Dados Pessoais</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold mb-1">Nome Completo *</label>
                            <input type="text" id="nome" required class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">CPF *</label>
                            <input type="text" id="cpf" required class="input-style" placeholder="000.000.000-00">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">E-mail *</label>
                            <input type="email" id="email" required class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">Telefone / WhatsApp *</label>
                            <input type="tel" id="telefone" required class="input-style" placeholder="(71) 99999-9999">
                        </div>
                    </div>

                    <h2 class="text-2xl mb-4 border-b pb-2 mt-8">2. Endereço de Entrega</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-semibold mb-1">CEP *</label>
                            <input type="text" id="cep" required class="input-style" placeholder="00000-000">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold mb-1">Rua / Logradouro *</label>
                            <input type="text" id="rua" required class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">Número *</label>
                            <input type="text" id="numero" required class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">Complemento</label>
                            <input type="text" id="complemento" class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">Bairro *</label>
                            <input type="text" id="bairro" required class="input-style">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold mb-1">Cidade *</label>
                            <input type="text" id="cidade" required class="input-style">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold mb-1">Estado (UF) *</label>
                            <input type="text" id="estado" required class="input-style" maxlength="2" placeholder="BA">
                        </div>
                    </div>

                    <div class="pt-6">
                        <button type="submit" id="btn-finalizar" class="w-full bg-gray-900 text-white py-4 uppercase tracking-widest text-sm hover:bg-brand transition">
                            Finalizar e Enviar Pedido
                        </button>
                        <p class="text-xs text-center text-gray-400 mt-3">Ao clicar, você será redirecionado para o WhatsApp para combinar o pagamento e o frete.</p>
                    </div>
                </form>
            </div>

            <!-- Resumo do Pedido -->
            <div class="lg:w-1/3">
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 sticky top-24">
                    <h2 class="text-xl mb-4 border-b pb-2">Resumo do Pedido</h2>
                    <div id="resumo-itens" class="space-y-4 mb-6 max-h-[300px] overflow-y-auto">
                        <!-- Itens via JS -->
                    </div>
                    <div class="border-t pt-4">
                        <div class="flex justify-between items-center text-lg font-bold">
                            <span>Total:</span>
                            <span id="resumo-total" class="text-brand"></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        import { createClient } from '@supabase/supabase-js';
        const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

        let carrinho = JSON.parse(localStorage.getItem('carrinho_vivi')) || [];

        function renderizarResumo() {
            const container = document.getElementById('resumo-itens');
            let total = 0;

            if (carrinho.length === 0) {
                container.innerHTML = '<p class="text-gray-500 text-sm">Seu carrinho está vazio.</p>';
                document.getElementById('btn-finalizar').disabled = true;
                return;
            }

            carrinho.forEach(item => {
                total += item.preco * item.quantidade;
                container.innerHTML += `
                    <div class="flex items-center gap-3 text-sm">
                        <img src="${item.imagem}" class="w-12 h-12 object-cover rounded">
                        <div class="flex-1">
                            <p class="font-semibold text-gray-800 leading-tight">${item.nome}</p>
                            <p class="text-gray-500 text-xs">Qtd: ${item.quantidade}</p>
                        </div>
                        <p class="font-medium">${new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.preco * item.quantidade)}</p>
                    </div>
                `;
            });

            document.getElementById('resumo-total').innerText = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(total);
        }

        renderizarResumo();

        document.getElementById('form-checkout').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-finalizar');
            btn.innerText = 'Processando...';
            btn.disabled = true;

            const dados = {
                cliente_nome: document.getElementById('nome').value,
                cliente_email: document.getElementById('email').value,
                cliente_telefone: document.getElementById('telefone').value,
                cliente_cpf: document.getElementById('cpf').value,
                endereco_cep: document.getElementById('cep').value,
                endereco_rua: document.getElementById('rua').value,
                endereco_numero: document.getElementById('numero').value,
                endereco_complemento: document.getElementById('complemento').value,
                endereco_bairro: document.getElementById('bairro').value,
                endereco_cidade: document.getElementById('cidade').value,
                endereco_estado: document.getElementById('estado').value,
                itens: carrinho,
                total_centavos: carrinho.reduce((acc, item) => acc + (item.preco * 100 * item.quantidade), 0)
            };

            // 1. Salva no banco de dados
            const { error } = await supabase.from('pedidos').insert([dados]);

            if (error) {
                alert("Erro ao salvar pedido: " + error.message);
                btn.innerText = 'Finalizar e Enviar Pedido';
                btn.disabled = false;
                return;
            }

            // 2. Monta a mensagem para o WhatsApp
            let mensagem = `*NOVO PEDIDO - SITE VIVI CORREA*%0A%0A`;
            mensagem += `*Cliente:* ${dados.cliente_nome}%0A`;
            mensagem += `*CPF:* ${dados.cliente_cpf}%0A`;
            mensagem += `*Telefone:* ${dados.cliente_telefone}%0A`;
            mensagem += `*Email:* ${dados.cliente_email}%0A%0A`;
            mensagem += `*Endereço:* ${dados.endereco_rua}, ${dados.endereco_numero} ${dados.endereco_complemento ? '- ' + dados.endereco_complemento : ''}%0A`;
            mensagem += `*Bairro:* ${dados.endereco_bairro} - ${dados.endereco_cidade}/${dados.endereco_estado}%0A`;
            mensagem += `*CEP:* ${dados.endereco_cep}%0A%0A`;
            mensagem += `*Itens do Pedido:*%0A`;
            
            carrinho.forEach(item => {
                mensagem += `- ${item.quantidade}x ${item.nome} (R$ ${item.preco.toFixed(2)})%0A`;
            });

            mensagem += `%0A*Total: R$ ${(dados.total_centavos / 100).toFixed(2)}*`;

            // 3. Limpa o carrinho e abre o WhatsApp
            localStorage.removeItem('carrinho_vivi');
            const numeroWhatsApp = "5571991064721"; 
            window.location.href = `https://wa.me/${numeroWhatsApp}?text=${mensagem}`;
        });
    </script>
</body>
</html>